# Home Dashboard — deploy configuration, read by deploy/install.sh.
#
# Copy to .env (gitignored) at the repo root, fill in, and run the
# installer. Precedence: command-line env vars > this file > defaults.
#
# This file configures DEPLOYMENT. For local development each component has
# its own env file:  tv-dashboard/.env.example  tv-dashboard-api/.env.example
# The full list of API options lives in tv-dashboard-api/.env.example.

# ── Deploy ────────────────────────────────────────────────────────────────

# Port nginx serves the dashboard on [80]
#HTTP_PORT=80

# Player shown when the dashboard URL has no ?player= [living_room]
# (baked into the frontend build AND set as the API default)
#DEFAULT_PLAYER=living_room

# ── Music API (seeded into /etc/tv-dashboard/api.env on FIRST install; ────
#    after that, edit that file on the container directly)

# Music backend [sonos]. Use "demo" for built-in fake data (no hardware).
#MUSIC_PROVIDER=sonos

# Static Sonos player IPs, comma-separated [empty = SSDP discovery].
# Set this if multicast discovery doesn't reach the container.
#SONOS_HOSTS=192.168.1.50,192.168.1.51

# Logical player ID -> Sonos room name, only when auto-derivation
# (living_room -> "Living Room") isn't enough:
#SONOS_PLAYER_OFFICE=Jack's Office

# Spotify enrichment (optional — Sonos-only without these):
#SPOTIFY_CLIENT_ID=
#SPOTIFY_CLIENT_SECRET=
#SPOTIFY_REFRESH_TOKEN=
