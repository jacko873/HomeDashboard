# Copy this file to .env (or .env.local) and adjust for your network.
# All variables must be prefixed with VITE_ to be exposed to the frontend.
# Values are baked in at build time — rebuild after changing them.

# Base URL of the Go music API (no trailing slash needed).
VITE_MUSIC_API_BASE_URL=http://music-api.home.arpa:8080

# Player shown when the URL has no ?player= query parameter.
VITE_DEFAULT_MUSIC_PLAYER=living_room

# Optional: how often (in milliseconds) the now-playing endpoint is polled.
# Defaults to 1000 (once per second).
#VITE_POLL_INTERVAL_MS=1000

# Optional, DEV SERVER ONLY: full path prefix the browser sees when `npm run
# dev` is accessed through a path-stripping proxy (Coder / code-server's
# /proxy/<port>/). Has no effect on builds. Example:
# DEV_PROXY_BASE=/@you/your-workspace.main/apps/code-server/proxy/5173
