# Copy to .env and adjust. All values are optional — defaults in brackets.
# Real environment variables always override the .env file.

# ── Server ────────────────────────────────────────────────────────────────

# Listen address [:8080]
#ADDR=:8080

# Access-Control-Allow-Origin value [*]. The dashboard calls this API
# straight from the browser, so this must cover the dashboard's origin.
#CORS_ALLOWED_ORIGIN=*

# URL browsers reach this API on, used for artwork links [derived from each
# request]. Only needed behind path-stripping proxies, e.g. code-server's
# /proxy/<port>/ inside Coder:
#PUBLIC_BASE_URL=https://<coder-host>/@<user>/<workspace>/apps/code-server/proxy/8080

# ── Music ─────────────────────────────────────────────────────────────────

# Music backend [sonos]. "demo" serves built-in fake data (no hardware).
#MUSIC_PROVIDER=sonos

# Player used when /api/music/now-playing has no ?player= [living_room]
#DEFAULT_PLAYER=living_room

# ── Sonos (source of truth) ───────────────────────────────────────────────

# Logical player ID -> Sonos room name. Unmapped IDs are derived
# automatically (living_room -> "Living Room"), so these are only needed
# when the names don't line up.
#SONOS_PLAYER_LIVING_ROOM=Living Room
#SONOS_PLAYER_KITCHEN=Kitchen

# Static player IPs, comma-separated [empty = SSDP discovery]. Useful when
# multicast discovery doesn't work (containers, VLANs).
#SONOS_HOSTS=192.168.1.50,192.168.1.51

# How often Sonos state is read per active player [1s]
#SONOS_POLL_INTERVAL=1s

# ── Spotify enrichment (optional — leave unset to run Sonos-only) ─────────
# Used only to fill metadata/artwork gaps; never the source of truth.

#SPOTIFY_CLIENT_ID=
#SPOTIFY_CLIENT_SECRET=
# Optional: unlocks the Spotify Connect queue (queue when casting from the
# Spotify app). Obtain via the one-time /api/music/spotify/login flow —
# see "Spotify Connect queue" in the README. Without it, the
# client-credentials flow is used (sufficient for track lookups).
#SPOTIFY_REFRESH_TOKEN=

# How long successful track lookups are reused [24h]
#SPOTIFY_CACHE_TTL=24h
# How long failed lookups are not retried [10m]
#SPOTIFY_NEGATIVE_CACHE_TTL=10m
# How long to pause ALL Spotify calls after a 429 [5m] (extended to the
# response's Retry-After when that is longer)
#SPOTIFY_RATE_LIMIT_COOLDOWN=5m

# ── Samsung TV integration (optional) ────────────────────────────────────
# IP address of Samsung TV for browser control
#SAMSUNG_TV_HOST=192.168.1.100
# Dashboard URL to open on the TV [https://tvdashboard.home.thecasualbot.com/music]
#SAMSUNG_TV_DASHBOARD_URL=https://tvdashboard.home.thecasualbot.com/music
