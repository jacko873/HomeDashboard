# Copy to .env to override. All values are optional — defaults in brackets.
# Only VITE_-prefixed vars are exposed to the browser bundle.

# Base URL of the Go API ['' = same origin]. Leave empty in production: nginx
# (or the API's own WEB_STATIC_DIR static serving) answers /api on the same
# origin. Set only to point at a remote API, e.g. http://music-api.home.arpa:8000
#VITE_API_BASE_URL=

# Default music player when the URL has no ?player= [living_room].
#VITE_DEFAULT_MUSIC_PLAYER=living_room

# How often the Spotify now-playing endpoint is polled, in ms [1000].
#VITE_POLL_INTERVAL_MS=1000

# --- Local dev only -------------------------------------------------------
# Where the Vite dev server proxies /api in `npm run dev` [http://localhost:8000].
#VITE_DEV_API_PROXY=http://localhost:8000

# Comma-separated hostnames the dev server accepts [any]. Vite blocks unknown
# Host headers by default, which breaks access through remote/coder forwards.
#VITE_ALLOWED_HOSTS=
