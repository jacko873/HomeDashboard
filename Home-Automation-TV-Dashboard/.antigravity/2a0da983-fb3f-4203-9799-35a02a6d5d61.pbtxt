  file_change {
    absolute_path_uri: "file:///src/components/TasklistsOverview.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useEffect, useState } from \'react\';\nimport { \n  Cpu, \n  Rocket, \n  Wrench, \n  Leaf, \n  AlertCircle,\n  FolderOpen,\n  CheckCircle2,\n  ListTodo\n} from \'lucide-react\';\nimport { Tasklist } from \'../types\';\n\ninterface TasklistsOverviewProps {\n  onSelectList: (listId: string) => void;\n  setActiveTab: (tab: string) => void;\n}\n\nexport default function TasklistsOverview({ onSelectList, setActiveTab }: TasklistsOverviewProps) {\n  const [lists, setLists] = useState<Tasklist[]>([]);\n  const [loading, setLoading] = useState(true);\n\n  useEffect(() => {\n    async function fetchLists() {\n      try {\n        const response = await fetch(\'/mock_api/tasklists.json\');\n        const data = await response.json();\n        setLists(data.tasklists);\n        setLoading(false);\n      } catch (err) {\n        console.error(\'Error fetching list summaries:\', err);\n        setLoading(false);\n      }\n    }\n    fetchLists();\n  }, []);\n\n  const getIcon = (iconName: string) => {\n    switch (iconName) {\n      case \'Cpu\': return <Cpu className=\"w-8 h-8\" />;\n      case \'Rocket\': return <Rocket className=\"w-8 h-8\" />;\n      case \'Wrench\': return <Wrench className=\"w-8 h-8\" />;\n      case \'Leaf\': return <Leaf className=\"w-8 h-8\" />;\n      default: return <ListTodo className=\"w-8 h-8\" />;\n    }\n  };\n\n  const getColorClasses = (color: string) => {\n    switch (color) {\n      case \'indigo\': return {\n        bg: \'bg-indigo-500/10 hover:bg-indigo-500/15\',\n        border: \'border-indigo-500/20 hover:border-indigo-500/40\',\n        text: \'text-indigo-400\',\n        fillBar: \'bg-indigo-500 shadow-indigo-500/30\'\n      };\n      case \'amber\': return {\n        bg: \'bg-amber-400/10 hover:bg-amber-400/15\',\n        border: \'border-amber-400/20 hover:border-amber-400/40\',\n        text: \'text-amber-400\',\n        fillBar: \'bg-amber-400 shadow-amber-400/30\'\n      };\n      case \'emerald\': return {\n        bg: \'bg-emerald-500/10 hover:bg-emerald-500/15\',\n        border: \'border-emerald-500/20 hover:border-emerald-500/40\',\n        text: \'text-emerald-400\',\n        fillBar: \'bg-emerald-500 shadow-emerald-500/30\'\n      };\n      case \'rose\': return {\n        bg: \'bg-rose-500/10 hover:bg-rose-500/15\',\n        border: \'border-rose-500/20 hover:border-rose-500/40\',\n        text: \'text-rose-400\',\n        fillBar: \'bg-rose-500 shadow-rose-500/30\'\n      };\n      default: return {\n        bg: \'bg-slate-900\',\n        border: \'border-slate-800\',\n        text: \'text-slate-400\',\n        fillBar: \'bg-slate-500\'\n      };\n    }\n  };\n\n  if (loading) {\n    return (\n      <div className=\"flex-1 flex items-center justify-center bg-slate-950 text-slate-400\">\n        <div className=\"flex flex-col items-center gap-4\">\n          <div className=\"w-10 h-10 border-4 border-amber-400/20 border-t-amber-400 rounded-full animate-spin\" />\n          <p className=\"font-mono text-xs uppercase tracking-wider\">Syncing task configurations...</p>\n        </div>\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"flex-1 bg-slate-950 p-12 text-white overflow-y-auto\">\n      \n      {/* Banner info */}\n      <div className=\"flex justify-between items-end mb-10 border-b border-slate-900 pb-8\">\n        <div>\n          <p className=\"text-amber-400 font-mono text-sm uppercase tracking-widest mb-1.5\">MAPPED HOME CONTROLS</p>\n          <h2 className=\"text-4xl font-extrabold tracking-tight font-sans\">Tasklists Portfolio</h2>\n        </div>\n        <div className=\"text-right\">\n          <p className=\"text-base font-mono text-slate-500 uppercase tracking-widest font-bold\">\n            {lists.length} Active Lists\n          </p>\n        </div>\n      </div>\n\n      {/* Grid displays for lists portfolio - optimized with massive cards for 85\" screen */}\n      <div className=\"grid grid-cols-1 md:grid-cols-2 gap-8\">\n        {lists.map((list) => {\n          const classes = getColorClasses(list.color);\n          const completionPercent = Math.round((list.completedTasks / list.totalTasks) * 100);\n          return (\n            <button\n              key={list.id}\n              onClick={() => {\n                onSelectList(list.id);\n                setActiveTab(\'tasklist-detailed\');\n              }}\n              className={`w-full group text-left rounded-3xl p-8 border flex flex-col justify-between transition-all duration-300 ${classes.bg} ${classes.border} backdrop-blur-md shadow-lg shadow-black/30 min-h-[300px]`}\n            >\n              {/* Header inside list */}\n              <div className=\"w-full flex justify-between items-start\">\n                <div className={`p-4 rounded-2xl bg-slate-950 ${classes.text} border border-slate-800`}>\n                  {getIcon(list.icon)}\n                </div>\n                \n                {/* Visual Circle percentage graph */}\n                <div className=\"flex items-center gap-1.5 text-xs font-mono bg-slate-950/80 border border-slate-800 rounded-full px-3.5 py-1 text-slate-300 font-bold\">\n                  {completionPercent === 100 ? (\n                    <CheckCircle2 className=\"w-4 h-4 text-emerald-400\" />\n                  ) : (\n                    <span className=\"w-2 h-2 rounded-full bg-amber-400 animate-pulse\" />\n                  )}\n                  <span>{completionPercent}% COMPLETED</span>\n                </div>\n              </div>\n\n              {/* Title & Descriptors */}\n              <div className=\"mt-8\">\n                <h3 className=\"text-2xl font-extrabold tracking-tight text-white group-hover:text-amber-400 transition-colors\">\n                  {list.title}\n                </h3>\n                <p className=\"text-slate-400 text-sm mt-2 leading-relaxed line-clamp-2\">\n                  {list.description}\n                </p>\n              </div>\n\n              {/* Progress and indicators */}\n              <div className=\"w-full mt-8 pt-6 border-t border-slate-900/60\">\n                <div className=\"flex justify-between items-center text-xs font-mono text-slate-500 mb-2 font-bold\">\n                  <span>OUTSTANDING: {list.totalTasks - list.completedTasks} OF {list.totalTasks} TASKS</span>\n                  <span className=\"group-hover:translate-x-1 group-hover:text-amber-400 transition-all flex items-center gap-1.5 text-slate-300\">\n                    FOCUS DETAIL\n                    <FolderOpen className=\"w-4.5 h-4.5\" />\n                  </span>\n                </div>\n\n                <div className=\"w-full bg-slate-950 border border-slate-850 h-2 rounded-full overflow-hidden\">\n                  <div \n                    className={`h-full rounded-full transition-all duration-1000 ${classes.fillBar}`} \n                    style={{ width: `${completionPercent}%` }} \n                  />\n                </div>\n              </div>\n            </button>\n          );\n        })}\n      </div>\n\n      {/* Auxiliary Instructions Widget for 85\" TV layout context */}\n      <section className=\"bg-slate-900 border border-slate-800 rounded-3xl p-8 mt-12 flex flex-col md:flex-row justify-between items-center gap-6 shadow-xl shadow-slate-950/20\">\n        <div>\n          <h4 className=\"text-lg font-bold text-white tracking-tight\">Syncing Golang Handler</h4>\n          <p className=\"text-sm text-slate-400 mt-1 max-w-[650px] leading-relaxed\">\n            The data rendered here originates from <code className=\"font-mono text-amber-400 px-1.5 py-0.5 bg-slate-950 rounded text-xs\">/public/mock_api/tasklists.json</code>. Your future Go endpoint should write a JSON payload adhering to this schema to integrate with local TV clients.\n          </p>\n        </div>\n        <div className=\"p-4 rounded-xl bg-slate-950 border border-slate-800 font-mono text-xs text-amber-400 font-medium shrink-0\">\n          GET /api/tasklists\n        </div>\n      </section>\n    </div>\n  );\n}\n"
    }
