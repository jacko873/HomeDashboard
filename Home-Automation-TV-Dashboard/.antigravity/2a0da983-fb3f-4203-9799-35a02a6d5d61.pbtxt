us</span>\n        </div>\n      </div>\n\n      <div className=\"grid grid-cols-12 gap-8 relative z-10 items-stretch\">\n        {/* LEFT COLUMN: TODAY\'S FOCUS (7 Columns) */}\n        <div className=\"col-span-12 lg:col-span-6 flex flex-col gap-6\">\n          <div className=\"bg-white/[0.02] backdrop-blur-xl border border-white/10 p-8 rounded-[2.5rem] shadow-2xl flex-1 flex flex-col justify-between\">\n            <div>\n              <div className=\"flex justify-between items-start mb-8\">\n                <div className=\"flex items-center gap-3\">\n                  <div className=\"p-3 rounded-2xl bg-indigo-500/10 text-indigo-300 border border-indigo-505/25\">\n                    <CalendarCheck2 className=\"w-5 h-5\" />\n                  </div>\n                  <h3 className=\"text-2xl font-bold font-display text-white\">Today&apos;s Focus</h3>\n                </div>\n                {/* Sleek date badge */}\n                <div className=\"text-right\">\n                  <span className=\"text-3xl font-black font-display text-indigo-400 block leading-none\">12</span>\n                  <span className=\"text-[10px] font-mono font-extrabold text-slate-450 uppercase text-slate-400 tracking-widest mt-1 block\">Friday, June</span>\n                </div>\n              </div>\n\n              {/* Today list events */}\n              <div className=\"space-y-4\">\n                {todayEvents.length > 0 ? (\n                  todayEvents.map((evt) => (\n                    <button\n                      key={evt.id}\n                      onClick={() => setSelectedEvent(evt)}\n                      className={`w-full text-left p-5 rounded-2xl border transition-all duration-300 flex items-start gap-4 ${\n                        selectedEvent?.id === evt.id\n                          ? \'bg-[#18122d]/70 border-indigo-500/50 shadow-lg shadow-indigo-500/5 scale-[1.01]\'\n                          : \'bg-black/25 border-white/5 hover:border-white/10 hover:bg-