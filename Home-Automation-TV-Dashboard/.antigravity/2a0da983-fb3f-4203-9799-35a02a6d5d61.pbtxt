  file_change {
    absolute_path_uri: "file:///src/components/GroceryDashboard.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useEffect, useState } from \'react\';\nimport { \n  ShoppingBag, \n  Check, \n  Plus, \n  RotateCcw,\n  Egg,\n  Apple,\n  UtensilsCrossed,\n  PackageCheck\n} from \'lucide-react\';\nimport { GroceryCategory, GroceryItem } from \'../types\';\n\nexport default function GroceryDashboard() {\n  const [categories, setCategories] = useState<GroceryCategory[]>([]);\n  const [loading, setLoading] = useState(true);\n\n  useEffect(() => {\n    async function loadGroceryData() {\n      try {\n        const localGroceryRaw = localStorage.getItem(\'grocery_shelf_data\');\n        if (localGroceryRaw) {\n          setCategories(JSON.parse(localGroceryRaw));\n        } else {\n          const response = await fetch(\'/mock_api/grocery_list.json\');\n          const data = await response.json();\n          setCategories(data.categories);\n          localStorage.setItem(\'grocery_shelf_data\', JSON.stringify(data.categories));\n        }\n        setLoading(false);\n      } catch (err) {\n        console.error(\'Error fetching grocery list: \', err);\n        setLoading(false);\n      }\n    }\n    loadGroceryData();\n  }, []);\n\n  const toggleItemBought = (catName: string, itemId: string) => {\n    const updated = categories.map((cat) => {\n      if (cat.name === catName) {\n        const updatedItems = cat.items.map((item) => {\n          if (item.id === itemId) {\n            return { ...item, bought: !item.bought };\n          }\n          return item;\n        });\n        return { ...cat, items: updatedItems };\n      }\n      return cat;\n    });\n\n    setCategories(updated);\n    localStorage.setItem(\'grocery_shelf_data\', JSON.stringify(updated));\n  };\n\n  const getCategoryIcon = (catName: string) => {\n    if (catName.includes(\'Produce\')) return <Apple className=\"w-5 h-5 text-emerald-400\" />;\n    if (catName.includes(\'Dairy\')) return <Egg className=\"w-5 h-5 text-amber-400\" />;\n    if (catName.includes(\'Pantry\')) return <UtensilsCrossed className=\"w-5 h-5 text-orange-400\" />;\n    return <ShoppingBag className=\"w-5 h-5 text-sky-400\" />;\n  };\n\n  const resetCheckedItems = () => {\n    const updated = categories.map((cat) => {\n      const resetItems = cat.items.map((item) => ({ ...item, bought: false }));\n      return { ...cat, items: resetItems };\n    });\n    setCategories(updated);\n    localStorage.setItem(\'grocery_shelf_data\', JSON.stringify(updated));\n  };\n\n  if (loading) {\n    return (\n      <div className=\"flex-1 flex items-center justify-center bg-slate-950 text-slate-400\">\n        <div className=\"flex flex-col items-center gap-4\">\n          <div className=\"w-10 h-10 border-4 border-amber-400/20 border-t-amber-400 rounded-full animate-spin\" />\n          <p className=\"font-mono text-xs uppercase tracking-wider\">Syncing refrigerator stock...</p>\n        </div>\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"flex-1 bg-slate-950 p-12 text-white overflow-y-auto\">\n      \n      {/* Header section with Reset button mock control */}\n      <div className=\"flex flex-col md:flex-row items-start md:items-center justify-between gap-6 mb-10 border-b border-slate-900 pb-8\">\n        <div>\n          <p className=\"text-amber-400 font-mono text-xs uppercase tracking-widest font-bold\">Asteria Smart Kitchen</p>\n          <h2 className=\"text-4xl font-extrabold tracking-tight font-sans\">Grocery List Shelf</h2>\n        </div>\n        \n        <button \n          onClick={resetCheckedItems}\n          className=\"flex items-center gap-2 px-5 py-3 rounded-2xl bg-slate-900 hover:bg-slate-800 border border-slate-800 hover:border-slate-700 transition-all text-xs font-mono font-bold uppercase text-slate-300\"\n        >\n          <RotateCcw className=\"w-4.5 h-4.5\" />\n          <span>Reset checked state</span>\n        </button>\n      </div>\n\n      {/* Grid containing categorized grocery cells - massive spacing optimized for 85 inch viewing */}\n      <div className=\"grid grid-cols-1 md:grid-cols-2 gap-8\">\n        {categories.map((cat, catIdx) => {\n          const totalItemsCount = cat.items.length;\n          const boughtItemsCount = cat.items.filter((i) => i.bought).length;\n          \n          return (\n            <div \n              key={catIdx} \n              className=\"bg-slate-900 border border-slate-800/80 rounded-[28px] p-8 shadow-xl shadow-slate-950/20 flex flex-col justify-between\"\n            >\n              <div>\n                {/* Category Header Card */}\n                <div className=\"flex justify-between items-center mb-6\">\n                  <div className=\"flex items-center gap-3\">\n                    <div className=\"p-2.5 rounded-xl bg-slate-950 border border-slate-800 shrink-0\">\n                      {getCategoryIcon(cat.name)}\n                    </div>\n                    <h3 className=\"text-xl font-bold tracking-tight text-white font-sans\">{cat.name}</h3>\n                  </div>\n                  \n                  <span className=\"text-[10px] font-mono font-semibold px-2.5 py-1 rounded-full bg-slate-950 border border-slate-850 text-slate-400\">\n                    {boughtItemsCount} / {totalItemsCount} ACQUIRED\n                  </span>\n                </div>\n\n                {/* Items rows inside category */}\n                <div className=\"space-y-3\">\n                  {cat.items.map((item) => (\n                    <button\n                      key={item.id}\n                      onClick={() => toggleItemBought(cat.name, item.id)}\n                      className={`w-full flex items-center justify-between p-4 rounded-xl border text-left transition-all ${\n                        item.bought \n                          ? \'bg-slate-950/40 border-slate-950 opacity-50\' \n                          : \'bg-slate-950 border-slate-800/60 hover:border-slate-800 hover:bg-slate-900/60\'\n                      }`}\n                    >\n                      <div className=\"flex items-center gap-3 min-w-0\">\n                        {/* Interactive item checklist circle block */}\n                        <div className={`w-5.5 h-5.5 rounded-full border flex items-center justify-center shrink-0 ${\n                          item.bought \n                            ? \'bg-emerald-400/15 border-emerald-400 text-emerald-400\' \n                            : \'border-slate-800 bg-slate-900 text-transparent\'\n                        }`}>\n                          <Check className=\"w-3.5 h-3.5 stroke-[3px]\" />\n                        </div>\n                        \n                        <span className={`text-base font-semibold truncate leading-tight ${\n                          item.bought ? \'line-through text-slate-500 font-normal\' : \'text-slate-200\'\n                        }`}>\n                          {item.name}\n                        </span>\n                      </div>\n                      \n                      <span className=\"text-xs font-mono text-slate-500 shrink-0 font-bold ml-4\">\n                        {item.qty}\n                      </span>\n                    </button>\n                  ))}\n                </div>\n              </div>\n              \n              {/* Progress slider bar inside category bottom block */}\n              <div className=\"mt-8 pt-4 border-t border-slate-950\">\n                <div className=\"w-full bg-slate-950 h-1.5 rounded-full overflow-hidden\">\n                  <div \n                    className=\"bg-emerald-400 h-full rounded-full transition-all duration-500\" \n                    style={{ width: `${(boughtItemsCount / totalItemsCount) * 100}%` }} \n                  />\n                </div>\n              </div>\n            </div>\n          );\n        })}\n      </div>\n    </div>\n  );\n}\n"
    }
    diff {
      unified_diff {
