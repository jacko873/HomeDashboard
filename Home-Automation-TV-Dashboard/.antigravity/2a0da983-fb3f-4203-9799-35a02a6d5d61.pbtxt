    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "  return (\n    <aside id=\"sidebar-panel\" className=\"w-[320px] bg-slate-950/90 border-r border-slate-800 flex flex-col justify-between p-6 shrink-0 backdrop-blur-md\">\n      <div>\n        {/* TV Dashboard Title Header */}\n        <div className=\"mb-10 px-3\">\n          <div className=\"flex items-center gap-2 mb-1\">\n            <span className=\"w-3 h-3 rounded-full bg-amber-400 animate-pulse\" />\n            <p className=\"text-xs font-mono uppercase tracking-widest text-slate-400\">Home Automation OS</p>\n          </div>\n          <h1 className=\"text-2xl font-bold tracking-tight text-white font-sans\">\n            Asteria <span className=\"text-amber-400\">TV</span>\n          </h1>\n        </div>\n\n        {/* Sidebar Nav Items */}\n        <nav className=\"space-y-2\">\n          {menuItems.map((item) => {\n            const IconComponent = item.icon;\n            const isActive = activeTab === item.id;\n            return (\n              <button\n                key={item.id}\n                id={`nav-${item.id}`}\n                onClick={() => setActiveTab(item.id)}\n                className={`w-full flex items-center gap-4 px-4 py-3.5 rounded-xl text-left border transition-all duration-300 ${\n                  isActive\n                    ? \'bg-amber-400 text-slate-950 border-amber-400 font-medium shadow-lg shadow-amber-400/10\'\n                    : \'text-slate-300 hover:text-white hover:bg-slate-900 border-transparent hover:border-slate-800\'\n                }`}\n              >\n                <IconComponent className={`w-6 h-6 shrink-0 ${isActive ? \'text-slate-950\' : \'text-slate-400\'}`} />\n                <span className=\"text-base tracking-wide\">{item.label}</span>\n                {isActive && (\n                  <motion.div\n                    layoutId=\"activeIndicator\"\n                    className=\"ml-auto w-1.5 h-6 rounded-full bg-slate-950\"\n                    transition={{ type: \"spring\", stiffness: 380, damping: 30 }}\n                  />\n                )}\n              </button>\n            );\n          })}\n        </nav>\n      </div>\n\n      {/* Footer System Status Info */}\n      <div className=\"pt-6 border-t border-slate-900 space-y-4\">\n        {/* Remote control mode visualizer */}\n        <button\n          onClick={toggleRemoteMode}\n          className={`w-full flex items-center justify-between p-3 rounded-xl border text-xs font-mono transition-colors duration-200 ${\n            remoteMode \n              ? \'bg-amber-400/10 text-amber-400 border-amber-400/20\' \n              : \'bg-slate-900/40 text-slate-500 border-transparent hover:border-slate-800\'\n          }`}\n        >\n          <div className=\"flex items-center gap-2\">\n            <Keyboard className=\"w-4 h-4\" />\n            <span>TV Remote Mode (Keys)</span>\n          </div>\n          <span className={`px-2 py-0.5 rounded text-[10px] uppercase font-bold ${\n            remoteMode ? \'bg-amber-400 text-slate-950\' : \'bg-slate-800\'\n          }`}>\n            {remoteMode ? \'On\' : \'Off\'}\n          </span>\n        </button>\n\n        <div className=\"flex items-center justify-between px-3 text-slate-500 text-xs font-mono\">\n          <span>System Status</span>\n          <span className=\"flex items-center gap-1 text-emerald-400\">\n            <span className=\"w-1.5 h-1.5 rounded-full bg-emerald-400 animate-ping\" />\n            Online\n          </span>\n        </div>\n\n        <div className=\"text-[10px] font-mono text-slate-600 px-3 flex flex-col gap-0.5\">\n          <span>Resolution: 85&quot; UHD 4K Scaled</span>\n          <span>Companion: Rocky (Host)</span>\n        </div>\n      </div>"
      replacement_content: "  return (\n    <aside id=\"sidebar-panel\" className=\"w-[320px] bg-[#0a0a0a] border-r border-slate-800/50 flex flex-col justify-between p-6 shrink-0 backdrop-blur-md\">\n      <div>\n        {/* TV Dashboard Title Header */}\n        <div className=\"mb-10 px-3\">\n          <div className=\"flex items-center gap-2 mb-3\">\n            <div className=\"w-8 h-8 bg-white rounded-xl flex items-center justify-center shadow-lg shadow-white/10\">\n              <div className=\"w-4 h-4 bg-black rounded-full\"></div>\n            </div>\n            <p className=\"text-xs font-mono uppercase tracking-widest text-slate-450 text-slate-400 font-bold ml-1\">Asteria OS</p>\n          </div>\n          <h1 className=\"text-3xl font-extrabold tracking-tight text-white font-sans\">\n            Asteria <span className=\"text-amber-500 tracking-tighter\">TV</span>\n          </h1>\n        </div>\n\n        {/* Sidebar Nav Items */}\n        <nav className=\"space-y-2\">\n          {menuItems.map((item) => {\n            const IconComponent = item.icon;\n            const isActive = activeTab === item.id;\n            return (\n              <button\n                key={item.id}\n                id={`nav-${item.id}`}\n                onClick={() => setActiveTab(item.id)}\n                className={`w-full flex items-center gap-4 px-4 py-3.5 rounded-2xl text-left border transition-all duration-300 ${\n                  isActive\n                    ? \'bg-[#181818] text-white border-white/10 font-bold shadow-xl shadow-black/60\'\n                    : \'text-slate-400 hover:text-slate-100 hover:bg-[#111111] border-transparent hover:border-slate-800/40\'\n                }`}\n              >\n                <IconComponent className={`w-6 h-6 shrink-0 ${isActive ? \'text-amber-500\' : \'text-slate-500\'}`} />\n                <span className=\"text-base tracking-wide font-sans\">{item.label}</span>\n                {isActive && (\n                  <motion.div\n                    layoutId=\"activeIndicator\"\n                    className=\"ml-auto w-1.5 h-6 rounded-full bg-amber-500\"\n                    transition={{ type: \"spring\", stiffness: 380, damping: 30 }}\n                  />\n                )}\n              </button>\n            );\n          })}\n        </nav>\n      </div>\n\n      {/* Footer System Status Info */}\n      <div className=\"pt-6 border-t border-slate-900 space-y-4\">\n        {/* Remote control mode visualizer */}\n        <button\n          onClick={toggleRemoteMode}\n          className={`w-full flex items-center justify-between p-3.5 rounded-2xl border text-xs font-mono transition-colors duration-200 ${\n            remoteMode \n              ? \'bg-amber-500/10 text-amber-500 border-amber-500/20\' \n              : \'bg-black/40 text-slate-500 border-white/5 hover:border-slate-800\'\n          }`}\n        >\n          <div className=\"flex items-center gap-2\">\n            <Keyboard className=\"w-4 h-4\" />\n            <span>TV Remote Mode (Keys)</span>\n          </div>\n          <span className={`px-2 py-0.5 rounded-lg text-[10px] uppercase font-bold ${\n            remoteMode ? \'bg-amber-500 text-black\' : \'bg-[#181818] text-slate-400\'\n          }`}>\n            {remoteMode ? \'On\' : \'Off\'}\n          </span>\n        </button>\n\n        <div className=\"flex items-center justify-between px-3 text-slate-500 text-xs font-mono font-bold\">\n          <span>System Status</span>\n          <span className=\"flex items-center gap-1.5 text-emerald-400 font-extrabold animate-pulse\">\n            <span className=\"w-1.5 h-1.5 rounded-full bg-emerald-450 bg-emerald-400\" />\n            ONLINE\n          </span>\n        </div>\n\n        <div className=\"text-[10px] font-mono text-slate-650 text-slate-500 px-3 flex flex-col gap-0.5 font-semibold\">\n          <span>Resolution: 85&quot; UHD 4K Scaled</span>\n          <span>Companion: Rocky (Host)</span>\n        </div>\n      </div>"
