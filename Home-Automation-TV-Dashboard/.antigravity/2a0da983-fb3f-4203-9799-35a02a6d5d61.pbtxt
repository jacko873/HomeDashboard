  file_change {
    absolute_path_uri: "file:///src/components/TasklistsOverview.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useEffect, useState } from \'react\';\nimport { \n  Cpu, \n  Rocket, \n  Wrench, \n  Leaf, \n  AlertCircle,\n  FolderOpen,\n  CheckCircle2,\n  ListTodo\n} from \'lucide-react\';\nimport { Tasklist } from \'../types\';\n\ninterface TasklistsOverviewProps {\n  onSelectList: (listId: string) => void;\n  setActiveTab: (tab: string) => void;\n}\n\nexport default function TasklistsOverview({ onSelectList, setActiveTab }: TasklistsOverviewProps) {\n  const [lists, setLists] = useState<Tasklist[]>([]);\n  const [loading, setLoading] = useState(true);\n\n  useEffect(() => {\n    async function fetchLists() {\n      try {\n        const response = await fetch(\'/mock_api/tasklists.json\');\n        const data = await response.json();\n        setLists(data.tasklists);\n        setLoading(false);\n      } catch (err) {\n        console.error(\'Error fetching list summaries:\', err);\n        setLoading(false);\n      }\n    }\n    fetchLists();\n  }, []);\n\n  const getIcon = (iconName: string) => {\n    switch (iconName) {\n      case \'Cpu\': return <Cpu className=\"w-7 h-7\" />;\n      case \'Rocket\': return <Rocket className=\"w-7 h-7\" />;\n      case \'Wrench\': return <Wrench className=\"w-7 h-7\" />;\n      case \'Leaf\': return <Leaf className=\"w-7 h-7\" />;\n      default: return <ListTodo className=\"w-7 h-7\" />;\n    }\n  };\n\n  const getColorClasses = (color: string) => {\n    switch (color) {\n      case \'indigo\': return {\n        bg: \'bg-white/[0.02]\',\n        border: \'border-white/10 hover:border-indigo-400/40\',\n        text: \'text-indigo-400\',\n        fillBar: \'bg-indigo-550 bg-indigo-500 shadow-lg shadow-indigo-500/20\'\n      };\n      case \'amber\': return {\n        bg: \'bg-white/[0.02]\',\n        border: \'border-white/10 hover:border-amber-400/40\',\n        text: \'text-amber-400\',\n        fillBar: \'bg-amber-500 shadow-lg shadow-amber-500/20\'\n      };\n      case \'emerald\': return {\n        bg: \'bg-white/[0.02]\',\n        border: \'border-white/10 hover:border-emerald-400/40\',\n        text: \'text-emerald-400\',\n        fillBar: \'bg-emerald-555 bg-emerald-500 shadow-lg shadow-emerald-500/20\'\n      };\n      case \'rose\': return {\n        bg: \'bg-white/[0.02]\',\n        border: \'border-white/10 hover:border-rose-400/40\',\n        text: \'text-rose-400\',\n        fillBar: \'bg-rose-500 shadow-lg shadow-rose-500/20\'\n      };\n      default: return {\n        bg: \'bg-white/[0.02]\',\n        border: \'border-white/10 hover:border-white/20\',\n        text: \'text-slate-400\',\n        fillBar: \'bg-slate-500 shadow-lg\'\n      };\n    }\n  };\n\n  if (loading) {\n    return (\n      <div className=\"flex-1 flex items-center justify-center bg-[#050507] text-slate-400 font-mono\">\n        <div className=\"flex flex-col items-center gap-4\">\n          <div className=\"w-10 h-10 border-4 border-indigo-505/25 border-t-indigo-500 rounded-full animate-spin\" />\n          <p className=\"font-mono text-xs uppercase tracking-wider\">Syncing task configurations...</p>\n        </div>\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"flex-1 bg-gradient-to-b from-[#0e0f13] via-[#07080a] to-[#040405] p-12 text-white overflow-y-auto custom-scrollbar relative\">\n      {/* Soft floating glow lights */}\n      <div className=\"absolute top-0 right-1/4 w-[800px] h-[400px] bg-indigo-505/5 bg-indigo-500/5 rounded-full blur-[140px] pointer-events-none\" />\n\n      {/* Banner info */}\n      <div className=\"flex justify-between items-end mb-11 border-b border-white/5 pb-8 relative z-10\">\n        <div>\n          <div className=\"flex items-center gap-2 mb-1.5\">\n            <span className=\"w-2.5 h-2.5 rounded-full bg-indigo-400 animate-pulse\" />\n            <p className=\"text-[10px] font-mono tracking-widest text-[#a5b4fc] font-bold uppercase\">Mapped Core Controls</p>\n          </div>\n          <h2 className=\"text-4xl font-extrabold tracking-tight font-display text-white\">Tasklists Portfolio</h2>\n        </div>\n        <div className=\"text-right\">\n          <p className=\"text-sm font-mono text-slate-500 uppercase tracking-widest font-extrabold px-3.5 py-1.5 bg-white/5 rounded-full border border-white/5\">\n            {lists.length} Active Lists\n          </p>\n        </div>\n      </div>\n\n      {/* Grid displays for lists portfolio */}\n      <div className=\"grid grid-cols-1 md:grid-cols-2 gap-8 relative z-10\">\n        {lists.map((list) => {\n          const classes = getColorClasses(list.color);\n          const completionPercent = Math.round((list.completedTasks / list.totalTasks) * 100);\n          return (\n            <button\n              key={list.id}\n              onClick={() => {\n                onSelectList(list.id);\n                setActiveTab(\'tasklist-detailed\');\n              }}\n              className={`w-full group text-left rounded-[2.5rem] p-8 border flex flex-col justify-between transition-all duration-300 ${classes.bg} ${classes.border} backdrop-blur-xl shadow-2xl min-h-[300px] hover:scale-[1.01]`}\n            >\n              {/* Header inside list */}\n              <div className=\"w-full flex justify-between items-start\">\n                <div className={`p-4 rounded-2xl bg-white/5 ${classes.text} border border-white/5 shrink-0`}>\n                  {getIcon(list.icon)}\n                </div>\n                \n                {/* Completion bar status */}\n                <div className=\"flex items-center gap-1.5 text-xs font-mono bg-[#07080b] border border-white/5 rounded-full px-3.5 py-1.5 text-slate-300 font-bold\">\n                  {completionPercent === 100 ? (\n                    <CheckCircle2 className=\"w-4 h-4 text-emerald-400 animate-pulse\" />\n                  ) : (\n                    <span className=\"w-2 h-2 rounded-full bg-amber-400 animate-pulse\" />\n                  )}\n                  <span>{completionPercent}% Completed</span>\n                </div>\n              </div>\n\n              {/* Title & Descriptors */}\n              <div className=\"mt-8\">\n                <h3 className=\"text-2xl font-extrabold tracking-tight text-white group-hover:text-indigo-400 transition-colors font-display\">\n                  {list.title}\n                </h3>\n                <p className=\"text-slate-400 text-sm mt-2 leading-relaxed font-sans font-medium line-clamp-2\">\n                  {list.description}\n                </p>\n              </div>\n\n              {/* Progress and indicators */}\n              <div className=\"w-full mt-8 pt-6 border-t border-white/5\">\n                <div className=\"flex justify-between items-center text-[10px] font-mono text-slate-500 mb-2 font-extrabold uppercase\">\n                  <span>Pending: {list.totalTasks - list.completedTasks} of {list.totalTasks} Tasks</span>\n                  <span className=\"group-hover:translate-x-1 transition-all flex items-center gap-1.5 text-indigo-400 uppercase tracking-wider font-extrabold\">\n                    Detail Checklist\n                    <FolderOpen className=\"w-4 h-4\" />\n                  </span>\n                </div>\n\n                <div className=\"w-full bg-black/45 border border-white/5 h-2 rounded-full overflow-hidden mt-1.5\">\n                  <div \n                    className={`h-full rounded-full transition-all duration-750 ${classes.fillBar}`} \n                    style={{ width: `${completionPercent}%` }} \n                  />\n                </div>\n              </div>\n            </button>\n          );\n        })}\n      </div>\n\n      {/* Auxiliary Instructions Widget */}\n      <section className=\"bg-white/[0.02] border border-white/10 rounded-[2.5rem] p-8 mt-12 flex flex-col md:flex-row justify-between items-center gap-6 shadow-2xl relative z-10 backdrop-blur-xl\">\n        <div>\n          <h4 className=\"text-lg font-bold text-white tracking-tight font-display\">Syncing Golang Handler</h4>\n          <p className=\"text-sm text-slate-400 mt-1.5 max-w-[650px] leading-relaxed font-sans\">\n            The data rendered here originates from <code className=\"font-mono text-indigo-400 px-1.5 py-0.5 bg-black rounded text-xs border border-white/5 font-extrabold\">/public/mock_api/tasklists.json</code>. Your future Go endpoint should write a JSON payload adhering to this schema to integrate with local TV clients.\n          </p>\n        </div>\n        <div className=\"p-4 rounded-xl bg-black border border-white/5 font-mono text-xs text-indigo-400 font-extrabold shrink-0\">\n          GET /api/tasklists\n        </div>\n      </section>\n    </div>\n  );\n}"
    }
