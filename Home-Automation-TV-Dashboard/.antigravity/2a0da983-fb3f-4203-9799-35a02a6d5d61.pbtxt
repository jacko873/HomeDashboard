    instruction: "Change Sidebar to a high fidelity glass-morphic collapsed layout when not hovered/focused, and expandable on hover or focus."
    replacement_infos {
      original_chunk {
        target_content: "import React from \'react\';\nimport { \n  LayoutDashboard, \n  Music, \n  Film, \n  Tv, \n  ListTodo, \n  FolderOpen, \n  ShoppingBag, \n  Calendar, \n  Sparkles,\n  Keyboard\n} from \'lucide-react\';\nimport { motion } from \'motion/react\';\n\ninterface SidebarProps {\n  activeTab: string;\n  setActiveTab: (tab: string) => void;\n  remoteMode: boolean;\n  toggleRemoteMode: () => void;\n}\n\nexport default function Sidebar({ activeTab, setActiveTab, remoteMode, toggleRemoteMode }: SidebarProps) {\n  const menuItems = [\n    { id: \'daily-dashboard\', label: \'Daily Dashboard\', icon: LayoutDashboard },\n    { id: \'spotify\', label: \'Spotify Player\', icon: Music },\n    { id: \'movies\', label: \'Movie Server\', icon: Film },\n    { id: \'tv-shows\', label: \'TV Shows\', icon: Tv },\n    { id: \'tasklists\', label: \'All Tasklists\', icon: ListTodo },\n    { id: \'tasklist-detailed\', label: \'Task List Focus\', icon: FolderOpen },\n    { id: \'grocery\', label: \'Grocery Shelf\', icon: ShoppingBag },\n    { id: \'calendar\', label: \'Home Calendar\', icon: Calendar },\n    { id: \'assistant\', label: \'Rocky (Assistant)\', icon: Sparkles },\n  ];\n\n  return (\n    <aside id=\"sidebar-panel\" className=\"w-[320px] bg-[#0a0a0a] border-r border-slate-800/50 flex flex-col justify-between p-6 shrink-0 backdrop-blur-md\">\n      <div>\n        {/* TV Dashboard Title Header */}\n        <div className=\"mb-10 px-3\">\n          <div className=\"flex items-center gap-2 mb-3\">\n            <div className=\"w-8 h-8 bg-white rounded-xl flex items-center justify-center shadow-lg shadow-white/10\">\n              <div className=\"w-4 h-4 bg-black rounded-full\"></div>\n            </div>\n            <p className=\"text-xs font-mono uppercase tracking-widest text-slate-450 text-slate-400 font-bold ml-1\">Asteria OS</p>\n          </div>\n          <h1 className=\"text-3xl font-extrabold tracking-tight text-white font-sans\">\n            Asteria <span className=\"text-amber-500 tracking-tighter\">TV</span>\n          </h1>\n        </div>\n\n        {/* Sidebar Nav Items */}\n        <nav className=\"space-y-2\">\n          {menuItems.map((item) => {\n            const IconComponent = item.icon;\n            const isActive = activeTab === item.id;\n            return (\n              <button\n                key={item.id}\n                id={`nav-${item.id}`}\n                onClick={() => setActiveTab(item.id)}\n                className={`w-full flex items-center gap-4 px-4 py-3.5 rounded-2xl text-left border transition-all duration-300 ${\n                  isActive\n                    ? \'bg-[#181818] text-white border-white/10 font-bold shadow-xl shadow-black/60\'\n                    : \'text-slate-400 hover:text-slate-100 hover:bg-[#111111] border-transparent hover:border-slate-800/40\'\n                }`}\n              >\n                <IconComponent className={`w-6 h-6 shrink-0 ${isActive ? \'text-amber-500\' : \'text-slate-500\'}`} />\n                <span className=\"text-base tracking-wide font-sans\">{item.label}</span>\n                {isActive && (\n                  <motion.div\n                    layoutId=\"activeIndicator\"\n                    className=\"ml-auto w-1.5 h-6 rounded-full bg-amber-500\"\n                    transition={{ type: \"spring\", stiffness: 380, damping: 30 }}\n                  />\n                )}\n              </button>\n            );\n          })}\n        </nav>\n      </div>\n\n      {/* Footer System Status Info */}\n      <div className=\"pt-6 border-t border-slate-900 space-y-4\">\n        {/* Remote control mode visualizer */}\n        <button\n          onClick={toggleRemoteMode}\n          className={`w-full flex items-center justify-between p-3.5 rounded-2xl border text-xs font-mono transition-colors duration-200 ${\n            remoteMode \n              ? \'bg-amber-500/10 text-amber-500 border-amber-500/20\' \n              : \'bg-black/40 text-slate-500 border-white/5 hover:border-slate-800\'\n          }`}\n        >\n          <div className=\"flex items-center gap-2\">\n            <Keyboard className=\"w-4 h-4\" />\n            <span>TV Remote Mode (Keys)</span>\n          </div>\n          <span className={`px-2 py-0.5 rounded-lg text-[10px] uppercase font-bold ${\n            remoteMode ? \'bg-amber-500 text-black\' : \'bg-[#181818] text-slate-400\'\n          }`}>\n            {remoteMode ? \'On\' : \'Off\'}\n          </span>\n        </button>\n\n        <div className=\"flex items-center justify-between px-3 text-slate-500 text-xs font-mono font-bold\">\n          <span>System Status</span>\n          <span className=\"flex items-center gap-1.5 text-emerald-400 font-extrabold animate-pulse\">\n            <span className=\"w-1.5 h-1.5 rounded-full bg-emerald-450 bg-emerald-400\" />\n            ONLINE\n          </span>\n        </div>\n\n        <div className=\"text-[10px] font-mono text-slate-650 text-slate-500 px-3 flex flex-col gap-0.5 font-semibold\">\n          <span>Resolution: 85&quot; UHD 4K Scaled</span>\n          <span>Companion: Rocky (Host)</span>\n        </div>\n      </div>\n    </aside>\n  );\n}"
        replacement_content: "import React, { useState } from \'react\';\nimport { \n  LayoutDashboard, \n  Music, \n  Film, \n  Tv, \n  ListTodo, \n  FolderOpen, \n  ShoppingBag, \n  Calendar, \n  Sparkles,\n  Keyboard\n} from \'lucide-react\';\nimport { motion, AnimatePresence } from \'motion/react\';\n\ninterface SidebarProps {\n  activeTab: string;\n  setActiveTab: (tab: string) => void;\n  remoteMode: boolean;\n  toggleRemoteMode: () => void;\n}\n\nexport default function Sidebar({ activeTab, setActiveTab, remoteMode, toggleRemoteMode }: SidebarProps) {\n  const [isHovered, setIsHovered] = useState(false);\n  const [isFocused, setIsFocused] = useState(false);\n  const isExpanded = isHovered || isFocused;\n\n  const menuItems = [\n    { id: \'daily-dashboard\', label: \'Daily Dashboard\', icon: LayoutDashboard },\n    { id: \'spotify\', label: \'Spotify Player\', icon: Music },\n    { id: \'movies\', label: \'Movie Server\', icon: Film },\n    { id: \'tv-shows\', label: \'TV Shows\', icon: Tv },\n    { id: \'tasklists\', label: \'All Tasklists\', icon: ListTodo },\n    { id: \'tasklist-detailed\', label: \'Task List Focus\', icon: FolderOpen },\n    { id: \'grocery\', label: \'Grocery Shelf\', icon: ShoppingBag },\n    { id: \'calendar\', label: \'Home Calendar\', icon: Calendar },\n    { id: \'assistant\', label: \'Rocky (Assistant)\', icon: Sparkles },\n  ];\n\n  return (\n    <aside \n      id=\"sidebar-panel\" \n      onMouseEnter={() => setIsHovered(true)}\n      onMouseLeave={() => setIsHovered(false)}\n      onFocusCapture={() => setIsFocused(true)}\n      onBlurCapture={() => setIsFocused(false)}\n      className={`${\n        isExpanded ? \'w-[320px] px-6\' : \'w-[96px] px-4\'\n      } bg-white/[0.02] border-r border-white/5 flex flex-col justify-between py-8 shrink-0 backdrop-blur-2xl transition-all duration-500 ease-out relative z-30`}\n    >\n      <div>\n        {/* TV Dashboard Title Header */}\n        <div className={`mb-10 transition-all duration-300 ${isExpanded ? \'px-3\' : \'px-1 text-center flex flex-col items-center\'}`}>\n          <div className=\"flex items-center gap-2 mb-3\">\n            <div className=\"w-8 h-8 bg-white/10 rounded-xl flex items-center justify-center border border-white/20 shadow-md\">\n              <div className=\"w-3 h-3 bg-indigo-500 rounded-full animate-pulse\"></div>\n            </div>\n            {isExpanded && (\n              <p className=\"text-[10px] font-mono uppercase tracking-widest text-slate-400 font-extrabold ml-1\">Asteria OS</p>\n            )}\n          </div>\n          {isExpanded ? (\n            <h1 className=\"text-2xl font-black tracking-tight text-white font-sans\">\n              Asteria <span className=\"text-indigo-400 tracking-tighter\">TV</span>\n            </h1>\n          ) : (\n            <span className=\"text-lg font-black font-sans text-indigo-400\">A</span>\n          )}\n        </div>\n\n        {/* Sidebar Nav Items */}\n        <nav className=\"space-y-1.5\">\n          {menuItems.map((item) => {\n            const IconComponent = item.icon;\n            const isActive = activeTab === item.id;\n            return (\n              <button\n                key={item.id}\n                id={`nav-${item.id}`}\n                onClick={() => setActiveTab(item.id)}\n                className={`w-full flex items-center gap-4 px-4 py-3 rounded-2xl text-left border transition-all duration-300 outline-none relative group ${\n                  isActive\n                    ? \'bg-white/10 text-white border-white/15 font-semibold shadow-lg shadow-black/20\'\n                    : \'text-slate-400 hover:text-slate-100 hover:bg-white/5 border-transparent\'\n                }`}\n              >\n                <IconComponent className={`w-5 h-5 shrink-0 transition-transform duration-300 group-hover:scale-110 ${isActive ? \'text-indigo-400\' : \'text-slate-400\'}`} />\n                {isExpanded ? (\n                  <span className=\"text-sm tracking-wide font-sans mt-0.5 truncate\">{item.label}</span>\n                ) : (\n                  <span className=\"absolute left-24 bg-[#0a0a0c] border border-white/10 text-slate-100 text-xs py-1.5 px-3.5 rounded-lg opacity-0 pointer-events-none group-hover:opacity-100 transition-opacity duration-200 shadow-2xl z-50 whitespace-nowrap\">\n                    {item.label}\n                  </span>\n                )}\n                {isActive && isExpanded && (\n                  <motion.div\n                    layoutId=\"activeIndicator\"\n                    className=\"ml-auto w-1 h-5 rounded-full bg-indigo-450 bg-indigo-400\"\n                    transition={{ type: \"spring\", stiffness: 380, damping: 30 }}\n                  />\n                )}\n              </button>\n            );\n          })}\n        </nav>\n      </div>\n\n      {/* Footer System Status Info */}\n      <div className={`pt-6 border-t border-white/5 space-y-4 ${isExpanded ? \'\' : \'flex flex-col items-center\'}`}>\n        {/* Remote control mode visualizer */}\n        <button\n          onClick={toggleRemoteMode}\n          className={`flex items-center justify-between rounded-xl border text-xs font-mono transition-all duration-300 ${\n            isExpanded ? \'w-full p-3.5\' : \'p-3 w-11 justify-center\'\n          } ${\n            remoteMode \n              ? \'bg-indigo-500/15 text-indigo-400 border-indigo-500/30\' \n              : \'bg-white/[0.02] text-slate-500 border-white/5 hover:border-white/10\'\n          }`}\n          title=\"TV Remote Mode\"\n        >\n          <div className=\"flex items-center gap-2\">\n            <Keyboard className=\"w-4 h-4\" />\n            {isExpanded && <span>Remote Mode</span>}\n          </div>\n          {isExpanded && (\n            <span className={`px-2 py-0.5 rounded text-[9px] uppercase font-bold tracking-wider ${\n              remoteMode ? \'bg-indigo-500 text-white\' : \'bg-white/5 text-slate-400\'\n            }`}>\n              {remoteMode ? \'On\' : \'Off\'}\n            </span>\n          )}\n        </button>\n\n        {isExpanded ? (\n          <>\n            <div className=\"flex items-center justify-between px-3 text-slate-500 text-[10px] font-mono tracking-wider font-extrabold uppercase\">\n              <span>System Status</span>\n              <span className=\"flex items-center gap-1 text-emerald-400 font-extrabold animate-pulse\">\n                <span className=\"w-1.5 h-1.5 rounded-full bg-emerald-400\" />\n                ONLINE\n              </span>\n            </div>\n\n            <div className=\"text-[10px] font-mono text-slate-500 px-3 flex flex-col gap-0.5 font-bold\">\n              <span>Resolution: 85&quot; Apple Scale</span>\n              <span>Companion: Rocky (Host)</span>\n            </div>\n          </>\n        ) : (\n          <div className=\"w-2 h-2 rounded-full bg-emerald-400 animate-pulse\" title=\"System Online\" />\n        )}\n      </div>\n    </aside>\n  );\n}"
      }
      num_matches: 1
    }
  }
