        {task.priority} Priority\n                  </span>\n                  \n                  <span className=\"flex items-center gap-1 bg-slate-950 border border-slate-850 px-2.5 py-0.5 rounded-md text-slate-400\">\n                    <Calendar className=\"w-3.5 h-3.5\" />\n                    {task.dueDate}\n                  </span>\n                </div>\n              </div>\n\n              {/* Task Notes detail block */}\n              {task.notes && (\n                <div className=\"mt-3 bg-slate-950/40 p-3 rounded-xl border border-slate-900 max-w-[95%]\">\n                  <p className=\"text-slate-400 text-xs font-sans leading-relaxed flex items-start gap-1.5\">\n                    <FileText className=\"w-4 h-4 text-slate-500 shrink-0 mt-0.5\" />\n                    <span>{task.notes}</span>\n                  </p>\n                </div>\n              )}\n            </div>\n          </div>\n        ))}\n        \n        {tasks.length === 0 && (\n          <div className=\"text-center py-16 bg-slate-900 border border-slate-800 rounded-3xl p-8\">\n            <ListTodo className=\"w-12 h-12 text-slate-600 mx-auto mb-4\" />\n            <h4 className=\"text-lg font-bold text-slate-300\">No Checklist Tasks Selected</h4>\n            <p className=\"text-slate-500 text-sm mt-1\">Select another category to view detailed items.</p>\n          </div>\n        )}\n      </div>\n\n      {/* Persistence Note */}\n      <div className=\"mt-8 p-4 rounded-xl border border-dashed border-slate-800 bg-slate-900/20 text-xs font-mono text-slate-500 flex justify-between items-center\">\n        <span>State is dynamically synced locally using local storage for instant state preservation.</span>\n        <span className=\"text-amber-400 uppercase font-semibold\">GET & PUT /api/tasks</span>\n      </div>"
