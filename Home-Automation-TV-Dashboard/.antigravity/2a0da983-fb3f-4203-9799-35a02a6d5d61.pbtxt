  file_change {
    absolute_path_uri: "file:///src/components/CalendarDashboard.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useEffect, useState } from \'react\';\nimport { \n  Calendar as CalendarIcon, \n  ChevronLeft, \n  ChevronRight, \n  Clock, \n  MapPin, \n  ArrowRight,\n  Sparkles,\n  Info\n} from \'lucide-react\';\nimport { CalendarEvent } from \'../types\';\n\nexport default function CalendarDashboard() {\n  const [events, setEvents] = useState<CalendarEvent[]>([]);\n  const [loading, setLoading] = useState(true);\n  const [selectedEvent, setSelectedEvent] = useState<CalendarEvent | null>(null);\n\n  // Month configuration for June 2026 matching current time metrics\n  const monthName = \"June 2026\";\n  const daysInMonth = 30;\n  const startingDayOfWeek = 1; // 1 = Monday (June 1st, 2026 is a Monday)\n\n  useEffect(() => {\n    async function loadEvents() {\n      try {\n        const response = await fetch(\'/mock_api/calendar.json\');\n        const data = await response.json();\n        setEvents(data.events);\n        if (data.events && data.events.length > 0) {\n          setSelectedEvent(data.events[0]);\n        }\n        setLoading(false);\n      } catch (err) {\n        console.error(\'Error fetching calendar schedule:\', err);\n        setLoading(false);\n      }\n    }\n    loadEvents();\n  }, []);\n\n  const getEventForDay = (day: number) => {\n    const dayStr = `2026-06-${day < 10 ? \'0\' : \'\'}${day}`;\n    return events.filter(e => e.date === dayStr);\n  };\n\n  const getEventDotColor = (color: string) => {\n    switch (color) {\n      case \'indigo\': return \'bg-indigo-400\';\n      case \'amber\': return \'bg-amber-400\';\n      case \'emerald\': return \'bg-emerald-400\';\n      case \'sky\': return \'bg-sky-400\';\n      case \'rose\': return \'bg-rose-400\';\n      default: return \'bg-slate-400\';\n    }\n  };\n\n  const getCategoryBadgeClass = (color: string) => {\n    switch (color) {\n      case \'indigo\': return \'bg-indigo-500/10 text-indigo-400 border-indigo-500/20\';\n      case \'amber\': return \'bg-amber-500/10 text-amber-400 border-amber-500/20\';\n      case \'emerald\': return \'bg-emerald-500/10 text-emerald-400 border-emerald-500/20\';\n      case \'sky\': return \'bg-sky-500/10 text-sky-400 border-sky-500/20\';\n      case \'rose\': return \'bg-rose-500/10 text-rose-400 border-rose-500/20\';\n      default: return \'bg-slate-500/10 text-slate-400 border-slate-500/20\';\n    }\n  };\n\n  if (loading) {\n    return (\n      <div className=\"flex-1 flex items-center justify-center bg-slate-950 text-slate-400\">\n        <div className=\"flex flex-col items-center gap-4\">\n          <div className=\"w-10 h-10 border-4 border-amber-400/20 border-t-amber-400 rounded-full animate-spin\" />\n          <p className=\"font-mono text-xs uppercase tracking-wider\">Syncing calendar orbital schedules...</p>\n        </div>\n      </div>\n    );\n  }\n\n  // Generate date grids\n  const gridCells = [];\n  // Render preceding padding cells\n  for (let s = 0; s < startingDayOfWeek; s++) {\n    gridCells.push(<div key={`pad-${s}`} className=\"aspect-square bg-slate-950 border border-slate-900 opacity-20\" />);\n  }\n  // Render actual June calendar days\n  for (let d = 1; d <= daysInMonth; d++) {\n    const dayEvents = getEventForDay(d);\n    const isToday = d === 12; // matching 2026-06-12 current timestamp\n    \n    gridCells.push(\n      <button\n        key={`day-${d}`}\n        onClick={() => {\n          if (dayEvents.length > 0) {\n            setSelectedEvent(dayEvents[0]);\n          }\n        }}\n        className={`aspect-square p-3 border text-left flex flex-col justify-between transition-all relative ${\n          isToday\n            ? \'bg-amber-400/5 border-amber-400 hover:bg-amber-400/10\'\n            : \'bg-slate-900 border-slate-800/80 hover:bg-slate-800 hover:border-slate-700\'\n        }`}\n      >\n        <span className={`text-base font-bold font-mono ${\n          isToday ? \'text-amber-400 font-extrabold\' : \'text-slate-400\'\n        }`}>\n          {d}\n          {isToday && (\n            <span className=\"text-[9px] font-mono font-bold uppercase block text-amber-400 mt-0.5 tracking-tight\">Today</span>\n          )}\n        </span>\n\n        {/* Small calendar dot/bullet indicator block */}\n        <div className=\"flex flex-col gap-1.5 mt-2 max-h-[60%] overflow-hidden\">\n          {dayEvents.map((evt) => (\n            <div key={evt.id} className=\"flex items-center gap-1.5 min-w-0\">\n              <span className={`w-2 h-2 rounded-full shrink-0 ${getEventDotColor(evt.color)}`} />\n              <span className=\"text-[10px] truncate max-w-full text-slate-200 group-hover:text-amber-400 font-sans tracking-wide\">\n                {evt.title}\n              </span>\n            </div>\n          ))}\n        </div>\n      </button>\n    );\n  }\n\n  return (\n    <div className=\"flex-1 bg-slate-950 p-12 text-white overflow-y-auto\">\n      \n      {/* Upper header segment */}\n      <div className=\"flex justify-between items-end mb-10 border-b border-slate-900 pb-8\">\n        <div>\n          <p className=\"text-amber-400 font-mono text-xs uppercase tracking-widest font-bold\">Orbit & Schedule Master</p>\n          <h2 className=\"text-4xl font-extrabold tracking-tight font-sans\">Home Agenda Calendar</h2>\n        </div>\n        <div className=\"flex items-center gap-4 bg-slate-900 border border-slate-800 rounded-2xl px-6 py-3 font-semibold text-lg text-slate-100 font-mono\">\n          <CalendarIcon className=\"w-5 h-5 text-amber-400\" />\n          <span>{monthName}</span>\n        </div>\n      </div>\n\n      <div className=\"grid grid-cols-12 gap-8 items-start\">\n        {/* Left Side: Massive June 2026 Calendar Grid (8 Columns) */}\n        <div className=\"col-span-12 lg:col-span-8 bg-slate-900/60 border border-slate-800/80 p-8 rounded-[30px] shadow-xl\">\n          {/* Day Names headers */}\n          <div className=\"grid grid-cols-7 gap-2 mb-4 text-center font-mono text-xs font-bold text-slate-500 uppercase tracking-widest\">\n            <span>Mon</span>\n            <span>Tue</span>\n            <span>Wed</span>\n            <span>Thu</span>\n            <span>Fri</span>\n            <span>Sat</span>\n            <span>Sun</span>\n          </div>\n\n          <div className=\"grid grid-cols-7 gap-2\">\n            {gridCells}\n          </div>\n        </div>\n\n        {/* Right Side: Agenda sidebar (4 Columns) with focused event display */}\n        <div className=\"col-span-12 lg:col-span-4 flex flex-col gap-8\">\n          \n          {/* Focused event detailing bubble */}\n          <section className=\"bg-slate-900 border border-slate-800 p-8 rounded-[28px] shadow-xl flex flex-col gap-6\">\n            <div className=\"flex items-center gap-2\">\n              <Info className=\"w-5 h-5 text-amber-400\" />\n              <h3 className=\"text-xl font-bold tracking-tight text-white font-sans\">Focus Event</h3>\n            </div>\n\n            {selectedEvent ? (\n              <div className=\"space-y-4\">\n                <div className=\"flex items-center justify-between\">\n                  <span className={`px-2.5 py-0.5 rounded-md text-[10px] font-mono font-bold uppercase border ${getCategoryBadgeClass(selectedEvent.color)}`}>\n                    {selectedEvent.category}\n                  </span>\n                  <span className=\"text-xs font-mono font-bold text-slate-500 uppercase\">{selectedEvent.date}</span>\n                </div>\n\n                <h4 className=\"text-xl font-extrabold text-slate-150 text-slate-100 leading-snug\">\n                  {selectedEvent.title}\n                </h4>\n\n                <p className=\"text-slate-400 text-sm leading-relaxed mt-2 font-sans\">\n                  {selectedEvent.description}\n                </p>\n\n                <div className=\"flex items-center gap-2 text-xs font-mono text-slate-350 border-t border-slate-800/80 pt-4 mt-4 font-semibold text-slate-300\">\n                  <Clock className=\"w-4.5 h-4.5 text-slate-500\" />\n                  <span>Schedules: {selectedEvent.time}</span>\n                </div>\n              </div>\n            ) : (\n              <p className=\"text-slate-500 text-sm font-mono italic\">No event highlighted. Click a calendar cell containing bullets to focus.</p>\n            )}\n          </section>\n\n          {/* Chronological events agenda feed */}\n          <section className=\"bg-slate-900 border border-slate-800 p-8 rounded-[28px] shadow-xl flex flex-col gap-4\">\n            <h3 className=\"text-lg font-bold tracking-tight text-slate-200\">Agenda List</h3>\n            \n            <div className=\"space-y-3 max-h-[300px] overflow-y-auto pr-1\">\n              {events.map((evt) => (\n                <button\n                  key={evt.id}\n                  onClick={() => setSelectedEvent(evt)}\n                  className={`w-full text-left p-4 rounded-xl border flex flex-col gap-1 transition-all ${\n                    selectedEvent?.id === evt.id\n                      ? \'bg-slate-950 border-amber-400/45 text-white shadow\'\n                      : \'bg-slate-950 border-slate-850 hover:border-slate-800 text-slate-400 font-medium\'\n                  }`}\n                >\n                  <div className=\"flex justify-between items-center text-[10px] font-mono leading-none\">\n                    <span className=\"font-bold text-slate-500 uppercase\">{evt.date}</span>\n                    <span className=\"text-slate-500\">{evt.time}</span>\n                  </div>\n                  <h4 className={`text-sm font-bold mt-1 max-w-[90%] truncate ${\n                    selectedEvent?.id === evt.id ? \'text-amber-400\' : \'text-slate-255 text-slate-300\'\n                  }`}>\n                    {evt.title}\n                  </h4>\n                </button>\n              ))}\n            </div>\n          </section>\n        </div>\n      </div>\n    </div>\n  );\n}\n"
    }
