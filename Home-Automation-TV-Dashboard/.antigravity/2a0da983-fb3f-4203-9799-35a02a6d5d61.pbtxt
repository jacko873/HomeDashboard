ecdd3_1.5px,transparent_1.5px)] [background-size:24px_24px] [mask-image:radial-gradient(ellipse_50%_50%_at_50%_50%,#000_60%,transparent_100%)]\" />\n\n            {/* Stylized Rocky Portrait using full visual SVGs */}\n            <div className=\"w-60 h-60 relative flex items-center justify-center bg-[#050505] border border-white/5 rounded-full p-4 mb-6 shadow-inner\">\n              <svg viewBox=\"0 0 100 100\" className=\"w-full h-full text-amber-500 fill-transparent stroke-current stroke-[1.5]\" referrerPolicy=\"no-referrer\">\n                {/* Outer environment chamber ring */}\n                <circle cx=\"50\" cy=\"50\" r=\"46\" className=\"stroke-slate-800 stroke-[1] stroke-dasharray\" strokeDasharray=\"3 3\"/>\n                <circle cx=\"50\" cy=\"50\" r=\"42\" className=\"stroke-amber-500/20 stroke-[1]\" />\n                \n                {/* Pentagonal facet core framework */}\n                <polygon points=\"50,15 85,40 72,80 28,80 15,40\" className=\"stroke-amber-500/30\" />\n                \n                {/* Five legs arranged in radial pentamerous symmetry (The scary nice stone spider!) */}\n                {/* Leg 1 (Top) */}\n                <path d=\"M 50 15 L 50 5 C 45 1, 40 1, 48 0\" className=\"stroke-amber-500 stroke-[2] stroke-linecap-round\" strokeLinecap=\"round\" />\n                {/* Leg 2 (Right Top) */}\n                <path d=\"M 85 40 L 96 35 C 99 30, 99 25, 96 28\" className=\"stroke-amber-500 stroke-[2] stroke-linecap-round\" strokeLinecap=\"round\" />\n                {/* Leg 3 (Right Bottom) */}\n                <path d=\"M 72 80 L 82 90 C 85 93, 85 97, 80 94\" className=\"stroke-amber-555 stroke-amber-500 stroke-[2] stroke-linecap-round\" strokeLinecap=\"round\" />\n                {/* Leg 4 (Left Bottom) */}\n                <path d=\"M 28 80 L 18 90 C 15 93, 15 97, 20 94\" className=\"stroke-amber-555 stroke-amber-500 stroke-[2] stroke-linecap-round\" strokeLinecap=\"round\" />\n                {/* Leg 5 (Left Top) */}\n                <path d=\"M 15 40 L 4 35 C 1 30, 1 25, 4 28\" className=\"stroke-amber-555 stroke-amber-500 stroke-[2] stroke-linecap-round\" strokeLinecap=\"round\" />\n\n                {/* Central mineral core organism representing xenonite carapace with steel-fiber muscle tissue */}\n                <circle cx=\"50\" cy=\"50\" r=\"16\" className=\"stroke-amber-500/80 fill-[#050505] stroke-[2]\" />\n                <polygon points=\"50,38 60,46 56,58 44,58 40,46\" className=\"stroke-amber-550 fill-amber-500/20\" />\n                <circle cx=\"50\" cy=\"50\" r=\"4\" className=\"fill-amber-500 stroke-none\" />\n              </svg>\n              \n              {/* Hot environment gas indicator */}\n              <span className=\"absolute top-2 right-2 flex h-2.5 w-2.5\">\n                <span className=\"animate-ping absolute inline-flex h-full w-full rounded-full bg-rose-400 opacity-75\"></span>\n                <span className=\"relative inline-flex rounded-full h-2.5 w-2.5 bg-rose-500\"></span>\n              </span>\n            </div>\n\n            <h3 className=\"text-2xl font-bold tracking-tight text-white font-sans\">{rocky.name}</h3>\n            <p className=\"text-slate-400 text-xs font-mono mt-1 uppercase tracking-widest font-bold\">{rocky.species} Companion</p>\n            \n            {/* Live rotating quote bubble */}\n            <div className=\"mt-6 bg-black/40 p-4 rounded-2xl border border-white/5 w-full min-h-[90px] flex items-center justify-center text-center\">\n              <p className=\"text-xs italic text-amber-300 font-sans tracking-wide leading-relaxed font-semibold\">\n                {rocky.quotes[quoteIdx]}\n              </p>\n            </div>\n          </section>\n\n          {/* Environmental metrics console panel */}\n          <section className=\"bg-[#0a0a0a]/50 border border-white/5 p-8 rounded-[2.5rem] shadow-2xl\">\n            <h4 className=\"text-lg font-bold tracking-tight text-white mb-6 font-sans\">