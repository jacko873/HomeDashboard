  file_change {
    absolute_path_uri: "file:///src/components/TasklistDetailed.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useEffect, useState } from \'react\';\nimport { \n  ArrowLeft, \n  CheckSquare2, \n  Square, \n  Calendar, \n  AlertCircle,\n  FileText,\n  Plus,\n  Tv2,\n  Trash2,\n  ListTodo\n} from \'lucide-react\';\nimport { TaskDetailedItem, Tasklist } from \'../types\';\n\ninterface TasklistDetailedProps {\n  selectedListId: string;\n  onGoBack: () => void;\n}\n\nexport default function TasklistDetailed({ selectedListId, onGoBack }: TasklistDetailedProps) {\n  const [listMeta, setListMeta] = useState<Tasklist | null>(null);\n  const [tasks, setTasks] = useState<TaskDetailedItem[]>([]);\n  const [loading, setLoading] = useState(true);\n\n  // Load list metadata and corresponding detailed tasks\n  useEffect(() => {\n    async function loadData() {\n      try {\n        setLoading(true);\n        // Load tasklists metadata\n        const listMetaResponse = await fetch(\'/mock_api/tasklists.json\');\n        const listMetaData = await listMetaResponse.json();\n        const activeMeta = listMetaData.tasklists.find((l: Tasklist) => l.id === selectedListId);\n        setListMeta(activeMeta || null);\n\n        // Load detailed tasks map\n        // First check if user has custom states saved in LocalStorage\n        const localTasksRaw = localStorage.getItem(`tasks_detailed_${selectedListId}`);\n        if (localTasksRaw) {\n          setTasks(JSON.parse(localTasksRaw));\n        } else {\n          const detailResponse = await fetch(\'/mock_api/tasks_detailed.json\');\n          const detailedMap = await detailResponse.json();\n          const listDetailedTasks = detailedMap.tasks[selectedListId] || [];\n          setTasks(listDetailedTasks);\n          localStorage.setItem(`tasks_detailed_${selectedListId}`, JSON.stringify(listDetailedTasks));\n        }\n        setLoading(false);\n      } catch (err) {\n        console.error(\'Error loading task detail data:\', err);\n        setLoading(false);\n      }\n    }\n    loadData();\n  }, [selectedListId]);\n\n  // Persist updated checklist task state dynamically\n  const toggleTaskCompletion = (taskId: string) => {\n    const updatedTasks = tasks.map((task) => {\n      if (task.id === taskId) {\n        return { ...task, completed: !task.completed };\n      }\n      return task;\n    });\n    setTasks(updatedTasks);\n    localStorage.setItem(`tasks_detailed_${selectedListId}`, JSON.stringify(updatedTasks));\n\n    // Update list completion counts in state to maintain visual synchronization\n    if (listMeta) {\n      const completedCount = updatedTasks.filter((t) => t.completed).length;\n      setListMeta({\n        ...listMeta,\n        completedTasks: completedCount,\n        totalTasks: updatedTasks.length\n      });\n    }\n  };\n\n  const getPriorityBadgeColor = (priority: string) => {\n    switch (priority) {\n      case \'High\': return \'bg-rose-500/15 text-rose-400 border border-rose-500/25\';\n      case \'Medium\': return \'bg-amber-500/15 text-amber-400 border border-amber-500/25\';\n      case \'Low\': return \'bg-emerald-500/15 text-emerald-400 border border-emerald-500/25\';\n      default: return \'bg-slate-800 text-slate-400 border border-slate-700\';\n    }\n  };\n\n  if (loading) {\n    return (\n      <div className=\"flex-1 flex items-center justify-center bg-slate-950 text-slate-400\">\n        <div className=\"flex flex-col items-center gap-4\">\n          <div className=\"w-10 h-10 border-4 border-amber-400/20 border-t-amber-400 rounded-full animate-spin\" />\n          <p className=\"font-mono text-xs uppercase tracking-wider\">Syncing detailed checklists...</p>\n        </div>\n      </div>\n    );\n  }\n\n  const completionPercent = listMeta \n    ? Math.round((listMeta.completedTasks / listMeta.totalTasks) * 100) \n    : 0;\n\n  return (\n    <div className=\"flex-1 bg-slate-950 p-12 text-white overflow-y-auto\">\n      \n      {/* Header bar */}\n      <div className=\"flex flex-col md:flex-row items-start md:items-center justify-between gap-6 mb-8 pb-6 border-b border-slate-900\">\n        <button \n          onClick={onGoBack}\n          className=\"flex items-center gap-2 text-sm font-mono text-slate-400 hover:text-amber-400 transition-colors uppercase font-bold\"\n        >\n          <ArrowLeft className=\"w-4 h-4\" />\n          <span>Back to All Lists</span>\n        </button>\n\n        {listMeta && (\n          <div className=\"flex items-center gap-4 bg-slate-900 border border-slate-800 rounded-full px-5 py-2\">\n            <span className=\"text-xs font-mono text-slate-400 font-bold uppercase\">Completion Gradient:</span>\n            <div className=\"w-32 bg-slate-950 h-2.5 rounded-full overflow-hidden border border-slate-800\">\n              <div className=\"bg-amber-400 h-full rounded-full\" style={{ width: `${completionPercent}%` }} />\n            </div>\n            <span className=\"text-sm font-mono font-bold text-amber-450 text-amber-400\">{completionPercent}%</span>\n          </div>\n        )}\n      </div>\n\n      {listMeta ? (\n        <div className=\"mb-10\">\n          <p className=\"text-xs font-mono text-amber-400 uppercase tracking-widest font-bold\">Active Checklist View</p>\n          <h2 className=\"text-4xl font-extrabold tracking-tight font-sans text-white mt-1\">\n            {listMeta.title}\n          </h2>\n          <p className=\"text-slate-400 text-sm mt-2 max-w-[800px] leading-relaxed\">\n            {listMeta.description}\n          </p>\n        </div>\n      ) : (\n        <div className=\"mb-10\">\n          <h2 className=\"text-4xl font-extrabold tracking-tight font-sans text-white mt-1\">\n            Task List Detail\n          </h2>\n        </div>\n      )}\n\n      {/* Task detailed checklist grid */}\n      <div className=\"space-y-4\">\n        {tasks.map((task) => (\n          <div \n            key={task.id} \n            onClick={() => toggleTaskCompletion(task.id)}\n            className={`w-full group rounded-2xl p-5 border flex items-start gap-4 transition-all duration-200 cursor-pointer text-left ${\n              task.completed \n                ? \'bg-slate-900/30 border-slate-900/60 opacity-60 hover:opacity-85\'\n                : \'bg-slate-900 border-slate-800 hover:border-slate-700 shadow-md hover:shadow-lg shadow-black/10\'\n            }`}\n          >\n            {/* Custom styled checkbox with beautiful click feedback targeting TV remote usability */}\n            <div className=\"shrink-0 mt-1\">\n              {task.completed ? (\n                <div className=\"text-amber-400 p-0.5 rounded bg-amber-400/10 border border-amber-400/20\">\n                  <CheckSquare2 className=\"w-6 h-6\" />\n                </div>\n              ) : (\n                <div className=\"text-slate-500 hover:text-amber-400 p-0.5 rounded bg-slate-950 border border-slate-800\">\n                  <Square className=\"w-6 h-6 text-slate-600\" />\n                </div>\n              )}\n            </div>\n\n            <div className=\"flex-1 min-w-0\">\n              <div className=\"flex flex-col md:flex-row md:items-center justify-between gap-2\">\n                <h3 className={`text-lg font-bold tracking-tight text-slate-100 group-hover:text-amber-450 transition-colors ${\n                  task.completed ? \'line-through text-slate-500\' : \'\'\n                }`}>\n                  {task.title}\n                </h3>\n                \n                {/* Metatags */}\n                <div className=\"flex items-center gap-2.5 shrink-0 font-mono text-xs font-semibold\">\n                  <span className={`px-2.5 py-0.5 rounded-md ${getPriorityBadgeColor(task.priority)}`}>\n                    {task.priority} Priority\n                  </span>\n                  \n                  <span className=\"flex items-center gap-1 bg-slate-950 border border-slate-850 px-2.5 py-0.5 rounded-md text-slate-400\">\n                    <Calendar className=\"w-3.5 h-3.5\" />\n                    {task.dueDate}\n                  </span>\n                </div>\n              </div>\n\n              {/* Task Notes detail block */}\n              {task.notes && (\n                <div className=\"mt-3 bg-slate-950/40 p-3 rounded-xl border border-slate-900 max-w-[95%]\">\n                  <p className=\"text-slate-400 text-xs font-sans leading-relaxed flex items-start gap-1.5\">\n                    <FileText className=\"w-4 h-4 text-slate-500 shrink-0 mt-0.5\" />\n                    <span>{task.notes}</span>\n                  </p>\n                </div>\n              )}\n            </div>\n          </div>\n        ))}\n        \n        {tasks.length === 0 && (\n          <div className=\"text-center py-16 bg-slate-900 border border-slate-800 rounded-3xl p-8\">\n            <ListTodo className=\"w-12 h-12 text-slate-600 mx-auto mb-4\" />\n            <h4 className=\"text-lg font-bold text-slate-300\">No Checklist Tasks Selected</h4>\n            <p className=\"text-slate-500 text-sm mt-1\">Select another category to view detailed items.</p>\n          </div>\n        )}\n      </div>\n\n      {/* Persistence Note */}\n      <div className=\"mt-8 p-4 rounded-xl border border-dashed border-slate-800 bg-slate-900/20 text-xs font-mono text-slate-500 flex justify-between items-center\">\n        <span>State is dynamically synced locally using local storage for instant state preservation.</span>\n        <span className=\"text-amber-400 uppercase font-semibold\">GET & PUT /api/tasks</span>\n      </div>\n    </div>\n  );\n}\n"
    }
