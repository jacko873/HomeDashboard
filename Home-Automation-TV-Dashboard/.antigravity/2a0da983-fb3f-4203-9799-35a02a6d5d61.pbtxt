  file_change {
    absolute_path_uri: "file:///src/components/DailyOverview.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useEffect, useState } from \'react\';\nimport { \n  Sun, \n  Cloud, \n  CloudSun, \n  Moon, \n  Droplets, \n  Wind, \n  Newspaper, \n  Clapperboard, \n  Tv2, \n  Calendar, \n  CheckSquare, \n  Sparkles,\n  ArrowRight,\n  UserCheck\n} from \'lucide-react\';\nimport { WeatherInfo, LocalNewsItem, MovieRelease, CalendarEvent, Tasklist } from \'../types\';\nimport { motion } from \'motion/react\';\n\ninterface DailyOverviewProps {\n  setActiveTab: (tab: string) => void;\n  setSelectedListId?: (listId: string) => void;\n}\n\nexport default function DailyOverview({ setActiveTab, setSelectedListId }: DailyOverviewProps) {\n  const [weatherData, setWeatherData] = useState<WeatherInfo | null>(null);\n  const [news, setNews] = useState<LocalNewsItem[]>([]);\n  const [releases, setReleases] = useState<MovieRelease[]>([]);\n  const [events, setEvents] = useState<CalendarEvent[]>([]);\n  const [lists, setLists] = useState<Tasklist[]>([]);\n  const [loading, setLoading] = useState(true);\n\n  useEffect(() => {\n    async function fetchData() {\n      try {\n        const dashboardRes = await fetch(\'/mock_api/daily_dashboard.json\');\n        const dashboard = await dashboardRes.json();\n        setWeatherData(dashboard.weather);\n        setNews(dashboard.localNews);\n        setReleases(dashboard.releases);\n\n        // Fetch calendar and tasklists to show summaries here too\n        const calendarRes = await fetch(\'/mock_api/calendar.json\');\n        const calendarData = await calendarRes.json();\n        setEvents(calendarData.events.slice(0, 3)); // first 3 events\n\n        const tasklistsRes = await fetch(\'/mock_api/tasklists.json\');\n        const tasklistData = await tasklistsRes.json();\n        setLists(tasklistData.tasklists);\n\n        setLoading(false);\n      } catch (err) {\n        console.error(\'Error loading daily dashboard metrics:\', err);\n        setLoading(false);\n      }\n    }\n    fetchData();\n  }, []);\n\n  const getWeatherIcon = (iconName: string) => {\n    switch (iconName) {\n      case \'Sun\': return <Sun className=\"w-12 h-12 text-amber-400\" />;\n      case \'Cloud\': return <Cloud className=\"w-12 h-12 text-slate-400\" />;\n      case \'CloudSun\': return <CloudSun className=\"w-12 h-12 text-amber-300\" />;\n      case \'Moon\': return <Moon className=\"w-12 h-12 text-indigo-300\" />;\n      default: return <Sun className=\"w-12 h-12 text-amber-400\" />;\n    }\n  };\n\n  const getEventBadgeColor = (color: string) => {\n    switch (color) {\n      case \'indigo\': return \'bg-indigo-500/10 text-indigo-400 border-indigo-500/20\';\n      case \'amber\': return \'bg-amber-500/10 text-amber-400 border-amber-500/20\';\n      case \'emerald\': return \'bg-emerald-500/10 text-emerald-400 border-emerald-500/20\';\n      case \'sky\': return \'bg-sky-500/10 text-sky-400 border-sky-500/20\';\n      case \'rose\': return \'bg-rose-500/10 text-rose-400 border-rose-500/20\';\n      default: return \'bg-slate-500/10 text-slate-400 border-slate-500/20\';\n    }\n  };\n\n  if (loading) {\n    return (\n      <div className=\"flex-1 flex items-center justify-center bg-slate-950 text-slate-400\">\n        <div className=\"flex flex-col items-center gap-4\">\n          <div className=\"w-10 h-10 border-4 border-amber-400/20 border-t-amber-400 rounded-full animate-spin\" />\n          <p className=\"font-mono text-xs uppercase tracking-wider\">Syncing Home Dashboard...</p>\n        </div>\n      </div>\n    );\n  }\n\n  // Calculate aggregated outstanding tasks\n  const aggregatedRemaining = lists.reduce((acc, current) => acc + (current.totalTasks - current.completedTasks), 0);\n\n  return (\n    <div className=\"flex-1 overflow-y-auto bg-slate-950 p-12 text-white\">\n      {/* Top Banner with dynamic greeting */}\n      <div className=\"flex justify-between items-end mb-10\">\n        <div>\n          <p className=\"text-amber-400 font-mono text-sm uppercase tracking-widest mb-1.5\">Welcome Back, Overseer</p>\n          <h2 className=\"text-4xl font-extrabold tracking-tight font-sans\">Daily Overview Status</h2>\n        </div>\n        <div className=\"text-right\">\n          <p className=\"text-2xl font-light text-slate-100 font-mono\">\n            {new Date().toLocaleDateString(undefined, { weekday: \'long\', month: \'short\', day: \'numeric\' })}\n          </p>\n          <p className=\"text-sm font-mono text-slate-400 uppercase tracking-wider\">Asteria Outpost Location</p>\n        </div>\n      </div>\n\n      {/* Grid container spanning across the massive space on 85\" screen */}\n      <div className=\"grid grid-cols-12 gap-8\">\n        \n        {/* Left Side: Large Weather Card & Local News (7 Columns) */}\n        <div className=\"col-span-12 lg:col-span-8 flex flex-col gap-8\">\n          \n          {/* Main Weather Hero Canvas */}\n          {weatherData && (\n            <section className=\"bg-slate-900 border border-slate-800 rounded-3xl p-8 flex flex-col md:flex-row justify-between items-stretch gap-8 shadow-xl shadow-slate-950/40\">\n              <div className=\"flex flex-col justify-between\">\n                <div>\n                  <div className=\"flex items-center gap-2 mb-1\">\n                    <span className=\"w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse\" />\n                    <span className=\"text-xs font-mono uppercase text-emerald-400 tracking-wider\">Microclimate Sensors</span>\n                  </div>\n                  <h3 className=\"text-5xl font-extrabold font-sans leading-none text-white tracking-tight flex items-baseline gap-1\">\n                    {weatherData.currentTemp}\302\260\n                    <span className=\"text-2xl text-slate-400 font-normal\">F</span>\n                  </h3>\n                  <p className=\"text-lg font-medium text-slate-300 mt-2\">{weatherData.condition}</p>\n                </div>\n\n                <div className=\"flex items-center gap-6 mt-8 border-t border-slate-800 pt-6\">\n                  <div className=\"flex items-center gap-2\">\n                    <Droplets className=\"w-5 h-5 text-sky-400\" />\n                    <div className=\"text-xs font-mono\">\n                      <p className=\"text-slate-500 leading-none\">HUMIDITY</p>\n                      <p className=\"text-slate-200 mt-0.5 font-medium\">{weatherData.humidityPercent}%</p>\n                    </div>\n                  </div>\n                  <div className=\"flex items-center gap-2\">\n                    <Wind className=\"w-5 h-5 text-emerald-400\" />\n                    <div className=\"text-xs font-mono\">\n                      <p className=\"text-slate-500 leading-none\">WIND SPEED</p>\n                      <p className=\"text-slate-200 mt-0.5 font-medium\">{weatherData.windSpeedMph} mph</p>\n                    </div>\n                  </div>\n                  <div className=\"flex items-center gap-2\">\n                    <div className=\"text-xs font-mono\">\n                      <p className=\"text-slate-500 leading-none\">RANGE</p>\n                      <p className=\"text-slate-200 mt-0.5 font-medium\">L: {weatherData.low}\302\260 \342\200\242 H: {weatherData.high}\302\260</p>\n                    </div>\n                  </div>\n                </div>\n              </div>\n\n              {/* Large Hourly Mini Forecast Panel for 85 inch glance-viewing */}\n              <div className=\"flex-1 bg-slate-950 border border-slate-800/80 rounded-2xl p-6 flex items-center justify-around gap-4\">\n                {weatherData.forecast.map((fc, idx) => (\n                  <div key={idx} className=\"flex flex-col items-center gap-2 text-center\">\n                    <span className=\"text-xs font-mono text-slate-500 uppercase\">{fc.time}</span>\n                    <span className=\"my-1\">{getWeatherIcon(fc.icon)}</span>\n                    <span className=\"text-lg font-bold font-mono text-white\">{fc.temp}\302\260</span>\n                  </div>\n                ))}\n              </div>\n            </section>\n          )}\n\n          {/* Local News Panel */}\n          <section className=\"bg-slate-900 border border-slate-800 rounded-3xl p-8 flex-1 flex flex-col justify-between shadow-xl\">\n            <div>\n              <div className=\"flex items-center gap-3 mb-6\">\n                <div className=\"p-2.5 rounded-xl bg-orange-500/10 text-orange-400 border border-orange-500/20\">\n                  <Newspaper className=\"w-6 h-6\" />\n                </div>\n                <h3 className=\"text-2xl font-bold text-white tracking-tight\">Broadcasting & Local News</h3>\n              </div>\n\n              <div className=\"space-y-6\">\n                {news.map((item) => (\n                  <div key={item.id} className=\"border-b border-slate-800/80 pb-6 last:border-b-0 last:pb-0\">\n                    <div className=\"flex items-center gap-2 mb-1.5\">\n                      <p className=\"text-[10px] font-mono text-orange-400 uppercase tracking-widest px-2 py-0.5 bg-orange-400/5 rounded border border-orange-400/15\">\n                        {item.source}\n                      </p>\n                    </div>\n                    <h4 className=\"text-lg font-bold text-slate-100 hover:text-amber-400 transition-colors duration-200 leading-snug\">\n                      {item.headline}\n                    </h4>\n                    <p className=\"text-slate-400 text-sm mt-1.5 leading-relaxed\">\n                      {item.snippet}\n                    </p>\n                  </div>\n                ))}\n              </div>\n            </div>\n\n            <div className=\"pt-4 border-t border-slate-800/50 mt-4 flex justify-between items-center text-slate-500 text-xs font-mono\">\n              <span>Automatic feed sync: every 30 mins</span>\n              <span className=\"text-orange-400\">2 priority bulletins</span>\n            </div>\n          </section>\n        </div>\n\n        {/* Right Side: Media Releases, Tasks Summary & Calendar Agenda (4 Columns) */}\n        <div className=\"col-span-12 lg:col-span-4 flex flex-col gap-8\">\n          \n          {/* Quick TV Control Tasks Summary Banner */}\n          <section className=\"bg-slate-900 border border-slate-800 rounded-3xl p-8 shadow-xl\">\n            <div className=\"flex items-center justify-between mb-4\">\n              <div className=\"p-2.5 rounded-xl bg-indigo-500/10 text-indigo-400 border border-indigo-500/20\">\n                <CheckSquare className=\"w-6 h-6\" />\n              </div>\n              <span className=\"text-[10px] font-mono uppercase bg-indigo-400/10 text-indigo-400 border border-indigo-400/20 px-2 py-0.5 rounded-md font-bold\">\n                Task Sync\n              </span>\n            </div>\n            <h3 className=\"text-4xl font-extrabold tracking-tight text-white mb-2 font-sans\">\n              {aggregatedRemaining} <span className=\"text-lg font-normal text-slate-400\">remaining</span>\n            </h3>\n            <p className=\"text-slate-400 text-sm leading-relaxed mb-6\">\n              You have outstanding items across your {lists.length} primary task categories. Keep coordinates optimized.\n            </p>\n\n            <div className=\"space-y-3\">\n              {lists.slice(0, 3).map((lst) => (\n                <button\n                  key={lst.id}\n                  onClick={() => {\n                    if (setSelectedListId) setSelectedListId(lst.id);\n                    setActiveTab(\'tasklist-detailed\');\n                  }}\n                  className=\"w-full flex items-center justify-between p-3.5 rounded-2xl bg-slate-950 hover:bg-slate-800 border border-slate-800/80 hover:border-slate-700 transition-all text-left text-xs\"\n                >\n                  <div className=\"flex flex-col gap-0.5\">\n                    <span className=\"font-bold text-slate-200\">{lst.title}</span>\n                    <span className=\"text-slate-500 font-mono font-medium\">Pending: {lst.totalTasks - lst.completedTasks} items</span>\n                  </div>\n                  <ArrowRight className=\"w-4 h-4 text-slate-500\" />\n                </button>\n              ))}\n            </div>\n          </section>\n\n          {/* TV and Movies Schedules Release Monitor */}\n          <section className=\"bg-slate-900 border border-slate-800 rounded-3xl p-8 shadow-xl flex-1 flex flex-col justify-between\">\n            <div>\n              <div className=\"flex items-center gap-3 mb-6\">\n                <div className=\"p-2.5 rounded-xl bg-purple-500/10 text-purple-400 border border-purple-500/20\">\n                  <Tv2 className=\"w-6 h-6\" />\n                </div>\n                <h3 className=\"text-2xl font-bold text-white tracking-tight\">Today&apos;s Broadcast Releases</h3>\n              </div>\n\n              <div className=\"space-y-4\">\n                {releases.map((rel) => (\n                  <div key={rel.id} className=\"p-4 rounded-2xl bg-slate-950 border border-slate-800/60 flex flex-col gap-1\">\n                    <div className=\"flex justify-between items-center\">\n                      <span className=\"text-[10px] font-mono uppercase bg-purple-500/10 text-purple-400 border border-purple-500/20 px-1.5 py-0.5 rounded font-bold\">\n                        {rel.type}\n                      </span>\n                      <span className=\"text-[10px] font-mono text-slate-500 font-bold\">{rel.releaseDay}</span>\n                    </div>\n                    <h4 className=\"font-bold text-slate-100 text-sm mt-1\">{rel.title}</h4>\n                    <p className=\"text-xs text-slate-500 mt-0.5 font-mono\">Platform: {rel.platform}</p>\n                  </div>\n                ))}\n              </div>\n            </div>\n\n            <div className=\"pt-4 border-t border-slate-800/50 mt-6 flex justify-between items-center\">\n              <button \n                onClick={() => setActiveTab(\'movies\')}\n                className=\"text-xs font-mono text-amber-400 flex items-center gap-1 hover:underline\"\n              >\n                Browse Movie Server \342\206\222\n              </button>\n            </div>\n          </section>\n        </div>\n      </div>\n\n      {/* Full-width Agenda Strip (Bottom) */}\n      <section className=\"bg-slate-900 border border-slate-800 rounded-3xl p-8 mt-8 shadow-xl\">\n        <div className=\"flex items-center justify-between mb-6\">\n          <div className=\"flex items-center gap-3\">\n            <div className=\"p-2.5 rounded-xl bg-emerald-500/10 text-emerald-400 border border-emerald-500/20\">\n              <Calendar className=\"w-6 h-6\" />\n            </div>\n            <h3 className=\"text-2xl font-bold text-white tracking-tight\">Upcoming Agenda</h3>\n          </div>\n          <button \n            onClick={() => setActiveTab(\'calendar\')}\n            className=\"text-xs font-mono text-amber-400 hover:underline\"\n          >\n            Open Home Calendar View \342\206\222\n          </button>\n        </div>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-3 gap-6\">\n          {events.map((event) => (\n            <div \n              key={event.id} \n              className={`p-5 rounded-2xl bg-slate-950 border ${getEventBadgeColor(event.color)} flex flex-col justify-between gap-4`}\n            >\n              <div>\n                <div className=\"flex items-center justify-between mb-1.5\">\n                  <span className=\"text-[10px] font-mono font-extrabold uppercase px-2 py-0.5 bg-slate-900 rounded border border-slate-800\">\n                    {event.category}\n                  </span>\n                  <span className=\"text-xs font-mono font-semibold text-slate-400\">{event.time}</span>\n                </div>\n                <h4 className=\"text-base font-bold text-slate-100 leading-snug\">{event.title}</h4>\n                <p className=\"text-xs text-slate-400 mt-2 leading-relaxed\">{event.description}</p>\n              </div>\n              <div className=\"text-[10px] font-mono text-slate-500 mt-2 border-t border-slate-900 pt-2 font-semibold\">\n                Event Date: {event.date}\n              </div>\n            </div>\n          ))}\n        </div>\n      </section>\n\n      {/* Rocky Assistant Quick Status Marquee */}\n      <section className=\"bg-amber-400/5 border border-amber-400/10 rounded-2xl p-4 mt-8 flex items-center justify-between gap-4\">\n        <div className=\"flex items-center gap-3\">\n          <div className=\"p-2 rounded-full bg-amber-400/10 text-amber-400\">\n            <Sparkles className=\"w-5 h-5 animate-pulse\" />\n          </div>\n          <p className=\"text-sm font-sans\">\n            <span className=\"font-bold text-amber-400 mr-2\">Rocky (Eridian companion):</span>\n            \342\200\234Human friend, Asteria climate looks balanced. No atmospheric leaks found! Fist bump?\342\200\235\n          </p>\n        </div>\n        <button \n          onClick={() => setActiveTab(\'assistant\')}\n          className=\"text-xs font-mono text-amber-400 shrink-0 hover:underline\"\n        >\n          Speak with Rocky \342\206\222\n        </button>\n      </section>\n    </div>\n  );\n}\n"
