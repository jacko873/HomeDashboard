    replacement_chunks {
      target_content: "  if (loading || !rocky) {\n    return (\n      <div className=\"flex-1 flex items-center justify-center bg-slate-950 text-slate-400\">\n        <div className=\"flex flex-col items-center gap-4\">\n          <div className=\"w-10 h-10 border-4 border-amber-400/20 border-t-amber-400 rounded-full animate-spin\" />\n          <p className=\"font-mono text-xs uppercase tracking-wider\">Acquiring acoustic translation link with Rocky...</p>\n        </div>\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"flex-1 bg-slate-950 p-12 text-white overflow-y-auto\">\n      \n      {/* Top Billboard Header */}\n      <div className=\"flex flex-col md:flex-row items-start md:items-end justify-between gap-6 mb-10 pb-8 border-b border-slate-900\">\n        <div>\n          <p className=\"text-amber-400 font-mono text-xs uppercase tracking-widest font-bold\">Xenon Systems Companion</p>\n          <h2 className=\"text-4xl font-extrabold tracking-tight font-sans\">Eridian Advisor: Rocky</h2>\n        </div>\n        <div className=\"text-right\">\n          <p className=\"text-base font-mono text-slate-500 uppercase tracking-widest font-bold\">Project Hail Mary Interface</p>\n        </div>\n      </div>\n\n      <div className=\"grid grid-cols-12 gap-8 items-start\">\n        \n        {/* Left Hand: Custom Rocky Vector Graphic & Status Console (5 Columns) */}\n        <div className=\"col-span-12 lg:col-span-5 flex flex-col gap-8\">\n          \n          {/* Rocky Pentamerous Symmetry Vector Frame */}\n          <section className=\"bg-gradient-to-b from-amber-450/10 to-amber-950/20 bg-slate-900 border border-slate-800 p-8 rounded-[32px] shadow-xl relative overflow-hidden flex flex-col items-center\">\n            {/* Hexagonal decorative grid background representing Rocky\'s shell facets */}\n            <div className=\"absolute inset-0 opacity-[0.02] pointer-events-none bg-[radial-gradient(#fecdd3_1.5px,transparent_1.5px)] [background-size:24px_24px] [mask-image:radial-gradient(ellipse_50%_50%_at_50%_50%,#000_60%,transparent_100%)]\" />\n\n            {/* Stylized Rocky Portrait using full visual SVGs */}\n            <div className=\"w-60 h-60 relative flex items-center justify-center bg-slate-950 border border-slate-800/80 rounded-full p-4 mb-6 shadow-inner\">\n              <svg viewBox=\"0 0 100 100\" className=\"w-full h-full text-amber-400 fill-transparent stroke-current stroke-[1.5]\" referrerPolicy=\"no-referrer\">\n                {/* Outer environment chamber ring */}\n                <circle cx=\"50\" cy=\"50\" r=\"46\" className=\"stroke-slate-800 stroke-[1] stroke-dasharray\" strokeDasharray=\"3 3\"/>\n                <circle cx=\"50\" cy=\"50\" r=\"42\" className=\"stroke-amber-400/20 stroke-[1]\" />\n                \n                {/* Pentagonal facet core framework */}\n                <polygon points=\"50,15 85,40 72,80 28,80 15,40\" className=\"stroke-amber-500/30\" />\n                \n                {/* Five legs arranged in radial pentamerous symmetry (The scary nice stone spider!) */}\n                {/* Leg 1 (Top) */}\n                <path d=\"M 50 15 L 50 5 C 45 1, 40 1, 48 0\" className=\"stroke-amber-400 stroke-[2] stroke-linecap-round\" strokeLinecap=\"round\" />\n                {/* Leg 2 (Right Top) */}\n                <path d=\"M 85 40 L 96 35 C 99 30, 99 25, 96 28\" className=\"stroke-amber-400 stroke-[2] stroke-linecap-round\" strokeLinecap=\"round\" />\n                {/* Leg 3 (Right Bottom) */}\n                <path d=\"M 72 80 L 82 90 C 85 93, 85 97, 80 94\" className=\"stroke-amber-400 stroke-[2] stroke-linecap-round\" strokeLinecap=\"round\" />\n                {/* Leg 4 (Left Bottom) */}\n                <path d=\"M 28 80 L 18 90 C 15 93, 15 97, 20 94\" className=\"stroke-amber-400 stroke-[2] stroke-linecap-round\" strokeLinecap=\"round\" />\n                {/* Leg 5 (Left Top) */}\n                <path d=\"M 15 40 L 4 35 C 1 30, 1 25, 4 28\" className=\"stroke-amber-400 stroke-[2] stroke-linecap-round\" strokeLinecap=\"round\" />\n\n                {/* Central mineral core organism representing xenonite carapace with steel-fiber muscle tissue */}\n                <circle cx=\"50\" cy=\"50\" r=\"16\" className=\"stroke-amber-550/80 fill-slate-900 stroke-[2]\" />\n                <polygon points=\"50,38 60,46 56,58 44,58 40,46\" className=\"stroke-amber-400 fill-amber-400/20\" />\n                <circle cx=\"50\" cy=\"50\" r=\"4\" className=\"fill-amber-400 stroke-none\" />\n              </svg>\n              \n              {/* Hot environment gas indicator */}\n              <span className=\"absolute top-2 right-2 flex h-2.5 w-2.5\">\n                <span className=\"animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75\"></span>\n                <span className=\"relative inline-flex rounded-full h-2.5 w-2.5 bg-red-500\"></span>\n              </span>\n            </div>\n\n            <h3 className=\"text-2xl font-bold tracking-tight text-white\">{rocky.name}</h3>\n            <p className=\"text-slate-400 text-xs font-mono mt-1 uppercase tracking-widest\">{rocky.species} Companion</p>\n            \n            {/* Live rotating quote bubble */}\n            <div className=\"mt-6 bg-slate-950 p-4 rounded-2xl border border-slate-850 w-full min-h-[90px] flex items-center justify-center text-center\">\n              <p className=\"text-xs italic text-amber-300 font-sans tracking-wide leading-relaxed\">\n                {rocky.quotes[quoteIdx]}\n              </p>\n            </div>\n          </section>\n\n          {/* Environmental metrics console panel */}\n          <section className=\"bg-slate-900 border border-slate-800 p-8 rounded-[32px] shadow-xl\">\n            <h4 className=\"text-lg font-bold tracking-tight text-white mb-6 font-sans\">Chamber Climate & Metrics</h4>\n            \n            <div className=\"grid grid-cols-2 gap-4\">\n              <div className=\"bg-slate-950 p-4 rounded-2xl border border-slate-850 flex items-center gap-3\">\n                <Thermometer className=\"w-5 h-5 text-red-400\" />\n                <div>\n                  <p className=\"text-[10px] font-mono text-slate-500 uppercase leading-none\">Chamber Temp</p>\n                  <p className=\"text-lg font-bold font-mono text-white mt-1\">{rocky.status.bodyTemp}</p>\n                </div>\n              </div>\n\n              <div className=\"bg-slate-950 p-4 rounded-2xl border border-slate-850 flex items-center gap-3\">\n                <Gauge className=\"w-5 h-5 text-emerald-400\" />\n                <div>\n                  <p className=\"text-[10px] font-mono text-slate-500 uppercase leading-none\">Pressure</p>\n                  <p className=\"text-lg font-bold font-mono text-white mt-1\">{rocky.status.chamberPressure}</p>\n                </div>\n              </div>\n\n              <div className=\"bg-slate-950 p-4 rounded-2xl border border-slate-850 flex items-center gap-3\">\n                <Dna className=\"w-5 h-5 text-purple-400\" />\n                <div>\n                  <p className=\"text-[10px] font-mono text-slate-500 uppercase leading-none\">Oxygen level</p>\n                  <p className=\"text-lg font-bold font-mono text-white mt-1\">{rocky.status.chamberOxygen}</p>\n                </div>\n              </div>\n\n              <div className=\"bg-slate-950 p-4 rounded-2xl border border-slate-850 flex items-center gap-3\">\n                <Heart className=\"w-5 h-5 text-rose-405 text-rose-400\" />\n                <div>\n                  <p className=\"text-[10px] font-mono text-slate-500 uppercase leading-none\">Vitals / Mood</p>\n                  <p className=\"text-sm font-bold text-slate-200 mt-1 truncate\">{rocky.status.mood}</p>\n                </div>\n              </div>\n            </div>\n\n            <div className=\"mt-5 p-4 rounded-xl bg-slate-950 border border-slate-850/60 text-xs\">\n              <p className=\"text-slate-400 leading-relaxed font-sans\">\n                <span className=\"font-bold text-amber-400 block mb-1\">CURRENT ACTIVITY:</span>\n                {rocky.status.activity}\n              </p>\n            </div>\n          </section>\n        </div>\n\n        {/* Right Hand: Vocabulary dictionary and Acoustic Translation Feed (7 Columns) */}\n        <div className=\"col-span-12 lg:col-span-12 xl:col-span-7 flex flex-col gap-8\">"
