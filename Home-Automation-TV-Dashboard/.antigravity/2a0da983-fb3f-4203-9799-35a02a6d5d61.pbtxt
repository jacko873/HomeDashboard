    instruction: "Refactor MoviesDashboard backgrounds, border parameters, and rounded edges to align with the Immersive theme"
    replacement_infos {
      original_chunk {
        target_content: "  if (loading) {\n    return (\n      <div className=\"flex-1 flex items-center justify-center bg-slate-950 text-slate-400\">\n        <div className=\"flex flex-col items-center gap-4\">\n          <div className=\"w-10 h-10 border-4 border-amber-400/20 border-t-amber-400 rounded-full animate-spin\" />\n          <p className=\"font-mono text-xs uppercase tracking-wider\">Syncing movie library server...</p>\n        </div>\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"flex-1 bg-slate-950 flex flex-col p-12 text-white overflow-y-auto\">\n      \n      {/* Dynamic Splash Hero Billboard (Top 45% of screen height) */}\n      {selectedMovie && (\n        <section className=\"relative w-full rounded-[30px] border border-slate-800 bg-slate-900 overflow-hidden shadow-2xl mb-12 shrink-0\">\n          {/* Cover image styling with extreme dark overlay vignette for TV typography */}\n          <div className=\"absolute inset-0 z-0\">\n            <img \n              src={selectedMovie.posterUrl} \n              alt={selectedMovie.title}\n              className=\"w-full h-full object-cover object-center opacity-30 transform scale-105 filter blur-xs\"\n              referrerPolicy=\"no-referrer\"\n            />\n            <div className=\"absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/80 to-transparent\" />\n            <div className=\"absolute inset-0 bg-gradient-to-r from-slate-950 via-slate-900/60 to-transparent\" />\n          </div>\n\n          <div className=\"relative z-10 px-10 py-12 flex flex-col justify-end min-h-[380px] max-w-[80%]\">\n            <div className=\"flex items-center gap-3 mb-3\">\n              <span className=\"px-2.5 py-1 text-xs font-mono font-bold uppercase tracking-widest bg-amber-400 text-slate-950 rounded-md\">\n                Featured Selection\n              </span>\n              <div className=\"flex items-center gap-1.5 text-xs font-mono bg-slate-950/80 rounded-md px-2.5 py-1 text-slate-300 border border-slate-800\">\n                <Star className=\"w-3.5 h-3.5 text-amber-400 fill-amber-400\" />\n                <span>{selectedMovie.rating} Rating</span>\n              </div>\n              <span className=\"text-xs font-mono text-slate-400\">{selectedMovie.year} \342\200\242 {selectedMovie.duration}</span>\n            </div>\n\n            <h2 className=\"text-5xl font-extrabold tracking-tight font-sans text-white mb-4 drop-shadow\">\n              {selectedMovie.title}\n            </h2>\n\n            <p className=\"text-slate-300 text-base leading-relaxed mb-6 max-w-[700px] font-sans\">\n              {selectedMovie.description}\n            </p>\n\n            <div className=\"flex items-center gap-3\">\n              {selectedMovie.genres.map((g, idx) => (\n                <span key={idx} className=\"px-3 py-1 bg-slate-800/80 border border-slate-700/60 rounded-full text-xs font-mono text-slate-300\">\n                  {g}\n                </span>\n              ))}\n            </div>\n            \n            {/* Play controls mockup */}\n            <div className=\"flex items-center gap-4 mt-8\">\n              <button className=\"flex items-center gap-2 bg-white text-slate-950 shadow-md px-6 py-3 rounded-xl font-bold hover:bg-slate-200 transition-colors\">\n                <Play className=\"w-5 h-5 fill-slate-950\" />\n                <span>Cast to 85&quot; TV</span>\n              </button>\n              <button className=\"flex items-center gap-2 bg-slate-850 bg-slate-800 border border-slate-700 hover:bg-slate-700 px-6 py-3 rounded-xl font-bold transition-colors\">\n                <Plus className=\"w-5 h-5\" />\n                <span>Add to Watchlist</span>\n              </button>\n            </div>\n          </div>\n        </section>\n      )}"
