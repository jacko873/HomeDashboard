ounded-md px-2.5 py-1 text-slate-300 border border-slate-800\">\n                \342\230\205 {focusedShow.rating}/10\n              </div>\n            </div>\n\n            <h2 className=\"text-5xl font-extrabold tracking-tight font-sans text-white mb-4\">\n              {focusedShow.title}\n            </h2>\n\n            <p className=\"text-slate-300 text-base leading-relaxed mb-6 max-w-[700px]\">\n              {focusedShow.description}\n            </p>\n\n            {/* Completion status gauge strip for continuing episodes */}\n            {focusedShow.progress > 0 && (\n              <div className=\"max-w-[400px] mb-8\">\n                <div className=\"flex justify-between items-center text-xs font-mono text-slate-400 mb-1.5 font-bold\">\n                  <span>RESUME STATUS</span>\n                  <span className=\"text-[#a78bfa]\">{focusedShow.progress}% VIEWED</span>\n                </div>\n                <div className=\"w-full bg-slate-950 border border-slate-800 h-2 rounded-full overflow-hidden\">\n                  <div className=\"bg-violet-500 h-full rounded-full shadow-md\" style={{ width: `${focusedShow.progress}%` }} />\n                </div>\n              </div>\n            )}\n\n            <div className=\"flex items-center gap-4\">\n              <button className=\"flex items-center gap-2 bg-white text-slate-950 shadow-md px-6 py-3 rounded-xl font-bold hover:bg-slate-200 transition-colors\">\n                <Play className=\"w-5 h-5 fill-slate-950\" />\n                <span>Resume Episode</span>\n              </button>\n              <button className=\"flex items-center gap-2 bg-slate-800 border border-slate-700 hover:bg-slate-700 px-6 py-3 rounded-xl font-bold transition-colors\">\n                <RotateCcw className=\"w-5 h-5\" />\n                <span>Restart Season</span>\n              </button>\n            </div>\n          </div>\n        </section>\n      )}\n\n      {/* Rows of TV Categories listed vertically */}\n      <div className=\"space-y-12\">\n        {lists.map((categoryList, listIdx) => (\n          <section key={listIdx} className=\"space-y-4\">\n            <h3 className=\"text-2xl font-bold text-slate-200 tracking-tight pl-2\">\n              {categoryList.category}\n            </h3>\n\n            <div className=\"grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6\">\n              {categoryList.items.map((show) => {\n                const isFocused = focusedShow?.id === show.id;\n                return (\n                  <button\n                    key={show.id}\n                    onClick={() => {\n                      setFocusedShow(show);\n                      document.getElementById(\'sidebar-panel\')?.scrollIntoView({ behavior: \'smooth\' });\n                    }}\n                    className={`w-full group text-left relative bg-slate-900 border transition-all duration-300 rounded-2xl overflow-hidden p-4 ${\n                      isFocused \n                        ? \'border-violet-550 border-violet-550/50 bg-[#0f0a1c]/60 shadow-2xl shadow-violet-550/5\' \n                        : \'border-slate-850/80 hover:border-slate-700 hover:bg-slate-900/60\'\n                    }`}\n                  >\n                    <div className=\"flex gap-4\">\n                      {/* Side thumbnail poster for TV listing layouts */}\n                      <img \n                        src={show.posterUrl} \n                        alt={show.title}\n                        className=\"w-[110px] h-[150px] rounded-xl object-cover shrink-0 border border-slate-800\"\n                        referrerPolicy=\"no-referrer\"\n                      />\n                      <div className=\"flex flex-col justify-between min-w-0 flex-1 py-1\">\n                        <div>\n                          <div className=\"flex justify-between items-start\">\n                            <p className=\"text-[10px] font-mono font-bold text-violet-400 uppercase tracking-wider\">\n                              {show.season}\n                            </p>\n                            <span className=\"text-xs text-amber-400 font-mono flex items-center shrink-0\">\n                              \342\230\205 {show.rating}\n                            </span>\n                          </div>\n                          <h4 className=\"font-bold text-sm text-slate-100 group-hover:text-violet-400 transition-colors mt-1 leading-tight truncate\">\n                            {show.title}\n                          </h4>\n                          <p className=\"text-xs text-slate-400 font-medium font-sans mt-1.5 line-clamp-1\">\n                            {show.episode}\n                          </p>\n                          <p className=\"text-[11px] text-slate-500 line-clamp-2 mt-1.5 leading-snug\">\n                            {show.description}\n                          </p>\n                        </div>\n\n                        {/* Miniature status line */}\n                        {show.progress > 0 ? (\n                          <div className=\"w-full bg-slate-950 h-1 rounded-full overflow-hidden mt-3\">\n                            <div className=\"bg-violet-500 h-full rounded-full\" style={{ width: `${show.progress}%` }} />\n                          </div>\n                        ) : (\n                          <p className=\"text-[10px] font-mono text-slate-500 font-bold mt-2\">NOT YET STARTED</p>\n                        )}\n                      </div>\n                    </div>\n                  </button>\n                );\n              })}\n            </div>\n          </section>\n        ))}\n      </div>\n    </div>"
      replacement_content: "  if (loading) {\n    return (\n      <div className=\"flex-1 flex items-center justify-center bg-[#050505] text-slate-400 font-mono\">\n        <div className=\"flex flex-col items-center gap-4\">\n          <div className=\"w-10 h-10 border-4 border-violet-400/20 border-t-violet-400 rounded-full animate-spin\" />\n          <p className=\"font-mono text-xs uppercase tracking-wider\">Syncing television library database...</p>\n        </div>\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"flex-1 bg-[#050505] flex flex-col p-12 text-white overflow-y-auto custom-scrollbar\">\n      \n      {/* Billboard Hero Focus Frame */}\n      {focusedShow && (\n        <section className=\"relative w-full rounded-[2.5rem] border border-white/5 bg-[#0a0a0a]/50 overflow-hidden shadow-2xl mb-12 shrink-0\">\n          <div className=\"absolute inset-0 z-0\">\n            <img \n              src={focusedShow.posterUrl} \n              alt={focusedShow.title}\n              className=\"w-full h-full object-cover object-center opacity-30 transform scale-102 filter blur-sm\"\n              referrerPolicy=\"no-referrer\"\n            />\n            <div className=\"absolute inset-0 bg-gradient-to-t from-[#050505] via-[#050505]/80 to-transparent\" />\n            <div className=\"absolute inset-0 bg-gradient-to-r from-[#050505] via-[#0a0a0a]/60 to-transparent\" />\n          </div>\n\n          <div className=\"relative z-10 px-10 py-12 flex flex-col justify-end min-h-[360px] max-w-[80%]\">\n            <div className=\"flex items-center gap-3 mb-3\">\n              <span className=\"px-2.5 py-1 text-[10px] font-mono font-bold uppercase tracking-widest bg-violet-600/80 text-white rounded-md border border-violet-455 border-violet-500/30\">\n                Active Broadcast\n              </span>\n              <span className=\"text-xs font-mono text-slate-400 font-bold\">\n                {focusedShow.season} \342\200\242 {focusedShow.episode}\n              </span>\n              <div className=\"text-xs font-mono bg-[#050505]/80 rounded-md px-2.5 py-1 text-amber-450 border border-white/5 font-extrabold\">\n                \342\230\205 {focusedShow.rating}/10\n              </div>\n            </div>\n\n            <h2 className=\"text-5xl font-extrabold tracking-tight font-display text-white mb-4\">\n              {focusedShow.title}\n            </h2>\n\n            <p className=\"text-slate-300 text-sm leading-relaxed mb-6 max-w-[700px] font-medium\">\n              {focusedShow.description}\n            </p>\n\n            {/* Completion status gauge strip for continuing episodes */}\n            {focusedShow.progress > 0 && (\n              <div className=\"max-w-[400px] mb-8\">\n                <div className=\"flex justify-between items-center text-xs font-mono text-slate-400 mb-1.5 font-bold\">\n                  <span>RESUME STATUS</span>\n                  <span className=\"text-violet-400 font-extrabold\">{focusedShow.progress}% VIEWED</span>\n                </div>\n                <div className=\"w-full bg-[#050505] border border-white/5 h-2 rounded-full overflow-hidden\">\n                  <div className=\"bg-violet-550 bg-violet-500 h-full rounded-full shadow-md shadow-violet-550/30\" style={{ width: `${focusedShow.progress}%` }} />\n                </div>\n              </div>\n            )}\n\n            <div className=\"flex items-center gap-4\">\n              <button className=\"flex items-center gap-2 bg-white text-slate-950 shadow-lg px-6 py-3 rounded-2xl font-bold hover:bg-slate-200 transition-all\">\n                <Play className=\"w-5 h-5 fill-slate-950\" />\n                <span>Resume Episode</span>\n              </button>\n              <button className=\"flex items-center gap-2 bg-zinc-900 border border-white/5 hover:bg-zinc-800 px-6 py-3 rounded-2xl font-bold transition-all\">\n                <RotateCcw className=\"w-5 h-5 text-slate-400\" />\n                <span>Restart Season</span>\n              </button>\n            </div>\n          </div>\n        </section>\n      )}\n\n      {/* Rows of TV Categories listed vertically */}\n      <div className=\"space-y-12\">\n        {lists.map((categoryList, listIdx) => (\n          <section key={listIdx} className=\"space-y-4\">\n            <h3 className=\"text-2xl font-bold text-slate-200 tracking-tight pl-2 font-display\">\n              {categoryList.category}\n            </h3>\n\n            <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6\">\n              {categoryList.items.map((show) => {\n                const isFocused = focusedShow?.id === show.id;\n                return (\n                  <button\n                    key={show.id}\n                    onClick={() => {\n                      setFocusedShow(show);\n                      document.getElementById(\'sidebar-panel\')?.scrollIntoView({ behavior: \'smooth\' });\n                    }}\n                    className={`w-full group text-left relative bg-[#0a0a0a]/50 border transition-all duration-300 rounded-[1.750rem] overflow-hidden p-4 ${\n                      isFocused \n                        ? \'border-violet-550 border-violet-550/50 bg-[#0f0a1c]/60 shadow-2xl shadow-violet-550/5\' \n                        : \'border-white/5 hover:border-white/10 hover:bg-[#111111]/80\'\n                    }`}\n                  >\n                    <div className=\"flex gap-4\">\n                      {/* Side thumbnail poster for TV listing layouts */}\n                      <img \n                        src={show.posterUrl} \n                        alt={show.title}\n                        className=\"w-[110px] h-[150px] rounded-2xl object-cover shrink-0 border border-white/5\"\n                        referrerPolicy=\"no-referrer\"\n                      />\n                      <div className=\"flex flex-col justify-between min-w-0 flex-1 py-1\">\n                        <div>\n                          <div className=\"flex justify-between items-start\">\n                            <p className=\"text-[10px] font-mono font-bold text-violet-400 uppercase tracking-wider\">\n                              {show.season}\n                            </p>\n                            <span className=\"text-xs text-amber-500 font-mono flex items-center shrink-0 font-extrabold\">\n                              \342\230\205 {show.rating}\n                            </span>\n                          </div>\n                          <h4 className=\"font-bold text-sm text-slate-100 group-hover:text-violet-400 transition-colors mt-1 leading-tight truncate font-sans\">\n                            {show.title}\n                          </h4>\n                          <p className=\"text-xs text-slate-400 font-medium font-sans mt-1.5 line-clamp-1\">\n                            {show.episode}\n                          </p>\n                          <p className=\"text-[11px] text-slate-500 line-clamp-2 mt-1.5 leading-snug\">\n                            {show.description}\n                          </p>\n                        </div>\n\n                        {/* Miniature status line */}\n                        {show.progress > 0 ? (\n                          <div className=\"w-full bg-black/40 border border-white/5 h-1.5 rounded-full overflow-hidden mt-3\">\n                            <div className=\"bg-violet-550 bg-violet-500 h-full rounded-full\" style={{ width: `${show.progress}%` }} />\n                          </div>\n                        ) : (\n                          <p className=\"text-[10px] font-mono text-slate-500 font-extrabold mt-2 uppercase tracking-wide\">NOT YET STARTED</p>\n                        )}\n                      </div>\n                    </div>\n                  </button>\n                );\n              })}\n            </div>\n          </section>\n        ))}\n      </div>\n    </div>"
    }
    instruction: "Convert TVShowsDashboard to use Immersive UI design theme"
  }
}
