 [\n      {\n        \"id\": \"lr1\",\n        \"title\": \"Re-generate atmospheric pressure reports (29 atmospheres)\",\n        \"completed\": true,\n        \"priority\": \"High\",\n        \"dueDate\": \"Today\",\n        \"notes\": \"Verify the high-pressure steel chamber pressure valves match digital calculations.\"\n      },\n      {\n        \"id\": \"lr2\",\n        \"title\": \"Calibrate text-to-music translation database dictionary\",\n        \"completed\": true,\n        \"priority\": \"High\",\n        \"dueDate\": \"Yesterday\",\n        \"notes\": \"Assigned pitches: Middle C = Hello, F-sharp = Danger, E-flat = Happy.\"\n      },\n      {\n        \"id\": \"lr3\",\n        \"title\": \"Add vocal text synthesis visualizer widget to dashboard\",\n        \"completed\": false,\n        \"priority\": \"Medium\",\n        \"dueDate\": \"June 15\",\n        \"notes\": \"Animate audio wave style trills to reflect Rocky\'s musical syntax.\"\n      },\n      {\n        \"id\": \"lr4\",\n        \"title\": \"Test \'Fist Bump\' recognition camera trigger\",\n        \"completed\": false,\n        \"priority\": \"Low\",\n        \"dueDate\": \"June 22\",\n        \"notes\": \"Verify hands detector identifies radial leg points of Eridian.\"\n      }\n    ],\n    \"list-maintenance\": [\n      {\n        \"id\": \"lm1\",\n        \"title\": \"Check server room backup RAID disk array status\",\n        \"completed\": true,\n        \"priority\": \"High\",\n        \"dueDate\": \"Every Friday\",\n        \"notes\": \"Disk 3 is re-silvered successfully. All sectors verified green.\"\n      },\n      {\n        \"id\": \"lm2\",\n        \"title\": \"Update Docker containers on central stack\",\n        \"completed\": true,\n        \"priority\": \"Medium\",\n        \"dueDate\": \"June 11\",\n        \"notes\": \"Plex Media Server, Home Assistant Core, and Mosquitto Broker updated.\"\n      },\n      {\n        \"id\": \"lm3\",\n        \"title\": \"Rotate API secrets and backup key files\",\n        \"completed\": false,\n        \"priority\": \"High\",\n        \"dueDate\": \"June 15\",\n        \"notes\": \"Place rotated key backups in securely encrypted vault.\"\n      },\n      {\n        \"id\": \"lm4\",\n        \"title\": \"Dust intake filters of the master rack locker\",\n        \"completed\": false,\n        \"priority\": \"Low\",\n        \"dueDate\": \"June 18\",\n        \"notes\": \"Temps are stable but dust accretion is visually getting noticeable.\"\n      }\n    ],\n    \"list-garden\": [\n      {\n        \"id\": \"lg1\",\n        \"title\": \"Refill primary nutrient solution tanks\",\n        \"completed\": false,\n        \"priority\": \"High\",\n        \"dueDate\": \"June 13\",\n        \"notes\": \"Formula A + B ratio 1:1. Target EC value is 2.1 mS/cm.\"\n      },\n      {\n        \"id\": \"lg2\",\n        \"title\": \"Verify automatic lighting relays\",\n        \"completed\": true,\n        \"priority\": \"Medium\",\n        \"dueDate\": \"June 10\",\n        \"notes\": \"Relay #4 correctly switches on at 06:00 and off at 22:00 local time.\"\n      }\n    ]\n  }\n}\n"
