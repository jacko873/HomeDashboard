x_24px] [mask-image:radial-gradient(ellipse_50%_50%_at_50%_50%,#000_60%,transparent_100%)]\" />\n\n            {/* Stylized Rocky Portrait using full visual SVGs */}\n            <div className=\"w-60 h-60 relative flex items-center justify-center bg-slate-950 border border-slate-800/80 rounded-full p-4 mb-6 shadow-inner\">\n              <svg viewBox=\"0 0 100 100\" className=\"w-full h-full text-amber-400 fill-transparent stroke-current stroke-[1.5]\" referrerPolicy=\"no-referrer\">\n                {/* Outer environment chamber ring */}\n                <circle cx=\"50\" cy=\"50\" r=\"46\" className=\"stroke-slate-800 stroke-[1] stroke-dasharray\" strokeDasharray=\"3 3\"/>\n                <circle cx=\"50\" cy=\"50\" r=\"42\" className=\"stroke-amber-400/20 stroke-[1]\" />\n                \n                {/* Pentagonal facet core framework */}\n                <polygon points=\"50,15 85,40 72,80 28,80 15,40\" className=\"stroke-amber-500/30\" />\n                \n                {/* Five legs arranged in radial pentamerous symmetry (The scary nice stone spider!) */}\n                {/* Leg 1 (Top) */}\n                <path d=\"M 50 15 L 50 5 C 45 1, 40 1, 48 0\" className=\"stroke-amber-400 stroke-[2] stroke-linecap-round\" strokeLinecap=\"round\" />\n                {/* Leg 2 (Right Top) */}\n                <path d=\"M 85 40 L 96 35 C 99 30, 99 25, 96 28\" className=\"stroke-amber-400 stroke-[2] stroke-linecap-round\" strokeLinecap=\"round\" />\n                {/* Leg 3 (Right Bottom) */}\n                <path d=\"M 72 80 L 82 90 C 85 93, 85 97, 80 94\" className=\"stroke-amber-400 stroke-[2] stroke-linecap-round\" strokeLinecap=\"round\" />\n                {/* Leg 4 (Left Bottom) */}\n                <path d=\"M 28 80 L 18 90 C 15 93, 15 97, 20 94\" className=\"stroke-amber-400 stroke-[2] stroke-linecap-round\" strokeLinecap=\"round\" />\n                {/* Leg 5 (Left Top) */}\n                <path d=\"M 15 40 L 4 35 C 1 30, 1 25, 4 28\" className=