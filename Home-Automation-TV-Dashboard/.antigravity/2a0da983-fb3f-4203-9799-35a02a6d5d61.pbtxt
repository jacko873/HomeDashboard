oup-hover:opacity-100\'\n                      }`}>\n                        <div className=\"flex justify-between items-center text-[10px] font-mono text-slate-300 mb-1\">\n                          <span>{movie.year}</span>\n                          <span className=\"flex items-center gap-0.5 text-amber-400\">\n                            <Star className=\"w-2.5 h-2.5 fill-amber-400\" />\n                            {movie.rating}\n                          </span>\n                        </div>\n                        <h4 className=\"font-bold text-sm text-white group-hover:text-amber-400 transition-colors duration-200 truncate pr-1\">\n                          {movie.title}\n                        </h4>\n                      </div>\n                    </div>\n                    {isFocused && (\n                      <span className=\"absolute top-3 right-3 bg-amber-400 text-slate-950 rounded-full p-1 shadow-md z-10 border border-slate-950\">\n                        <CheckCircle className=\"w-3.5 h-3.5 fill-slate-950\" />\n                      </span>\n                    )}\n                  </button>\n                );\n              })}\n            </div>\n          </section>\n        ))}"
