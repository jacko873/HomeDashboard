    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useEffect, useState } from \'react\';\nimport { \n  Play, \n  Pause, \n  Volume2, \n  Layers, \n  Sparkles,\n  Music4\n} from \'lucide-react\';\nimport { SpotifyState } from \'../types\';\n\nexport default function SpotifyDashboard() {\n  const [spotify, setSpotify] = useState<SpotifyState | null>(null);\n  const [progressMs, setProgressMs] = useState<number>(0);\n  const [loading, setLoading] = useState(true);\n\n  useEffect(() => {\n    async function fetchSpotifyData() {\n      try {\n        const response = await fetch(\'/mock_api/spotify.json\');\n        const data: SpotifyState = await response.json();\n        setSpotify(data);\n        setProgressMs(data.progressMs);\n        setLoading(false);\n      } catch (err) {\n        console.error(\'Error fetching Spotify info:\', err);\n        setLoading(false);\n      }\n    }\n    fetchSpotifyData();\n  }, []);\n\n  // Update song progress bar live\n  useEffect(() => {\n    if (!spotify || !spotify.isPlaying) return;\n\n    const interval = setInterval(() => {\n      setProgressMs((prev) => {\n        if (prev >= spotify.durationMs) {\n          return 0; // wrap around of song\n        }\n        return prev + 1000;\n      });\n    }, 1000);\n\n    return () => clearInterval(interval);\n  }, [spotify]);\n\n  const formatTime = (ms: number) => {\n    const totalSecs = Math.floor(ms / 1000);\n    const mins = Math.floor(totalSecs / 60);\n    const secs = totalSecs % 60;\n    return `${mins}:${secs < 10 ? \'0\' : \'\'}${secs}`;\n  };\n\n  if (loading || !spotify) {\n    return (\n      <div className=\"flex-1 flex items-center justify-center bg-[#050507] text-slate-400 font-mono\">\n        <div className=\"flex flex-col items-center gap-4\">\n          <div className=\"w-10 h-10 border-4 border-indigo-505/25 border-t-indigo-500 rounded-full animate-spin\" />\n          <p className=\"font-mono text-xs uppercase tracking-wider\">Connecting Spotify Host Stream...</p>\n        </div>\n      </div>\n    );\n  }\n\n  const progressPercent = Math.min((progressMs / spotify.durationMs) * 100, 100);\n\n  return (\n    <div className=\"flex-1 bg-gradient-to-b from-[#0e0f13] via-[#07080a] to-[#040405] p-12 text-white overflow-y-auto custom-scrollbar relative flex flex-col justify-between\">\n      {/* Background radial soft ambient blur */}\n      <div className=\"absolute top-0 right-0 w-[800px] h-[800px] bg-emerald-500/10 rounded-full blur-[150px] pointer-events-none -mr-40 -mt-40 transition-all duration-1000\" />\n      <div className=\"absolute bottom-0 left-0 w-[600px] h-[600px] bg-purple-500/5 rounded-full blur-[140px] pointer-events-none -ml-40 -mb-40\" />\n\n      {/* Header Info */}\n      <div className=\"flex justify-between items-center z-10 mb-8 pb-6 border-b border-white/5\">\n        <div>\n          <div className=\"flex items-center gap-2 mb-1.5\">\n            <span className=\"flex h-2 w-2 relative\">\n              <span className=\"animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-450 opacity-75\"></span>\n              <span className=\"relative inline-flex rounded-full h-2 w-2 bg-emerald-500\"></span>\n            </span>\n            <p className=\"font-mono text-xs uppercase text-emerald-400 tracking-wider font-extrabold\">Active Device: {spotify.deviceName}</p>\n          </div>\n          <h2 className=\"text-4xl font-extrabold tracking-tight font-display text-white\">Now Playing</h2>\n        </div>\n        <div className=\"bg-white/5 border border-white/10 rounded-2xl px-5 py-2.5 flex items-center gap-3 backdrop-blur-md\">\n          <Volume2 className=\"w-5 h-5 text-slate-400\" />\n          <div className=\"w-24 bg-white/10 h-1.5 rounded-full overflow-hidden\">\n            <div className=\"bg-emerald-400 h-full rounded-full\" style={{ width: `${spotify.volumePercent}%` }} />\n          </div>\n          <span className=\"text-xs font-mono font-bold text-slate-300\">{spotify.volumePercent}%</span>\n        </div>\n      </div>\n\n      {/* Main split dashboard (Left: Album Art & Controls, Right: Next 10 Songs Queue) */}\n      <div className=\"grid grid-cols-12 gap-12 z-10 flex-1 items-center\">\n        {/* Left Side: Massive High-Fidelity Album Art Frame for 85 inch screen */}\n        <div className=\"col-span-12 lg:col-span-7 flex flex-col md:flex-row items-center gap-10\">\n          <div className=\"relative group shrink-0\">\n            {/* Soft border shadow glowing with ambient artwork coloration */}\n            <div className=\"absolute inset-0 rounded-[2.5rem] bg-emerald-500/10 blur-[40px] opacity-60 scale-95 pointer-events-none\" />\n            <img \n              src={spotify.albumArtUrl} \n              alt={spotify.album}\n              className=\"w-[360px] h-[360px] md:w-[420px] md:h-[420px] rounded-[2.5rem] border border-white/15 object-cover shadow-2xl relative z-10 transition-transform duration-500\"\n              referrerPolicy=\"no-referrer\"\n            />\n            {/* Spinning small vinyl details in bottom corner for TV animation feel */}\n            <div className=\"absolute -bottom-2 -right-2 bg-slate-900 border border-white/15 p-2.5 rounded-full z-20 shadow-lg animate-spin\" style={{ animationDuration: \'10s\' }}>\n              <Music4 className=\"w-5.5 h-5.5 text-emerald-400\" />\n            </div>\n          </div>\n\n          <div className=\"flex-1 w-full flex flex-col justify-center text-center md:text-left\">\n            <p className=\"text-emerald-400 font-mono text-xs uppercase tracking-widest mb-1.5 font-extrabold\">Now Streaming</p>\n            <h3 className=\"text-4xl md:text-5xl font-black font-display tracking-tight text-white mb-2 leading-tight\">\n              {spotify.title}\n            </h3>\n            <p className=\"text-2xl text-slate-350 font-bold tracking-normal mb-1\">\n              {spotify.artist}\n            </p>\n            <p className=\"text-slate-500 font-bold text-sm tracking-wide\">\n              {spotify.album}\n            </p>\n\n            {/* TV player status panel (None-Interactive visual layout) */}\n            <div className=\"flex items-center gap-4 justify-center md:justify-start mt-8\">\n              <span className=\"p-3 bg-emerald-400 text-slate-950 rounded-full font-bold shadow-md\">\n                <Play className=\"w-5 h-5 fill-slate-950 text-slate-950\" />\n              </span>\n              <span className=\"text-[10px] font-mono tracking-widest text-emerald-400 uppercase bg-emerald-400/10 border border-emerald-400/20 px-3 py-1.5 rounded-full font-extrabold\">\n                Live Companion HUD\n              </span>\n            </div>\n          </div>\n        </div>\n\n        {/* Right Side: Next 10 Songs Queue */}\n        <div className=\"col-span-12 lg:col-span-5 bg-white/[0.02] border border-white/10 rounded-[2.5rem] p-8 h-[550px] overflow-hidden flex flex-col backdrop-blur-xl\">\n          <div className=\"flex items-center gap-2 mb-6 border-b border-white/5 pb-4\">\n            <Layers className=\"w-4 h-4 text-[#a5b4fc]\" />\n            <h3 className=\"text-lg font-extrabold text-white tracking-tight font-display\">Queue <span className=\"text-xs font-normal text-slate-500 font-mono font-extrabold uppercase\">({spotify.queue.length} Tracks)</span></h3>\n          </div>\n\n          <div className=\"flex-1 overflow-y-auto space-y-3 pr-2 custom-scrollbar\">\n            {spotify.queue.map((song, idx) => (\n              <div \n                key={song.id} \n                className=\"flex items-center justify-between p-3 rounded-2xl hover:bg-white/5 border border-transparent hover:border-white/5 transition-all group cursor-pointer\"\n              >\n                <div className=\"flex items-center gap-4 min-w-0\">\n                  <span className=\"text-xs font-mono font-extrabold text-slate-600 group-hover:text-emerald-400 w-4 block text-center\">\n                    {idx + 1}\n                  </span>\n                  <div className=\"min-w-0\">\n                    <h4 className=\"font-bold text-slate-200 text-sm group-hover:text-white truncate\">{song.title}</h4>\n                    <p className=\"text-xs text-slate-500 truncate mt-0.5\">{song.artist} \342\200\242 <span className=\"text-slate-600 italic font-medium\">{song.album}</span></p>\n                  </div>\n                </div>\n                <span className=\"text-xs font-mono text-slate-500 font-bold ml-3\">{song.duration}</span>\n              </div>\n            ))}\n          </div>\n        </div>\n      </div>\n\n      {/* Progress Bar & Timeline (Bottom Block) */}\n      <div className=\"z-10 mt-8 pt-8 border-t border-white/5\">\n        <div className=\"flex justify-between text-xs font-mono text-slate-450 mb-2.5 font-bold\">\n          <span>{formatTime(progressMs)}</span>\n          <span>{formatTime(spotify.durationMs)}</span>\n        </div>\n        <div className=\"w-full bg-black/40 h-2.5 rounded-full overflow-hidden border border-white/5\">\n          <div \n            className=\"bg-emerald-450 bg-emerald-500 h-full rounded-full transition-all duration-1000 ease-linear shadow-[0_0_15px_rgba(16,185,129,0.5)] animate-pulse\" \n            style={{ width: `${progressPercent}%` }} \n          />\n        </div>\n      </div>\n    </div>\n  );\n}"
    }
