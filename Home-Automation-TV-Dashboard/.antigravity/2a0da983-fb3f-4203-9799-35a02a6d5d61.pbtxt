      original_chunk {
        target_content: "  if (loading || !spotify) {\n    return (\n      <div className=\"flex-1 flex items-center justify-center bg-slate-950 text-slate-400\">\n        <div className=\"flex flex-col items-center gap-4\">\n          <div className=\"w-10 h-10 border-4 border-amber-400/20 border-t-amber-400 rounded-full animate-spin\" />\n          <p className=\"font-mono text-xs uppercase tracking-wider\">Connecting Spotify Host Stream...</p>\n        </div>\n      </div>\n    );\n  }\n\n  const progressPercent = Math.min((progressMs / spotify.durationMs) * 100, 100);\n\n  return (\n    <div className=\"flex-1 bg-slate-950 relative overflow-hidden flex flex-col justify-between p-12 text-white\">\n      {/* Background radial soft ambient blur matching the album art color gradient */}\n      <div className=\"absolute top-0 right-0 w-[800px] h-[800px] bg-sky-500/10 rounded-full blur-[140px] pointer-events-none -mr-40 -mt-40 transition-all duration-1000\" />\n      <div className=\"absolute bottom-0 left-0 w-[600px] h-[600px] bg-purple-500/5 rounded-full blur-[120px] pointer-events-none -ml-40 -mb-40\" />\n\n      {/* Header Info */}\n      <div className=\"flex justify-between items-center z-10 mb-8\">\n        <div>\n          <div className=\"flex items-center gap-2 mb-1\">\n            <span className=\"flex h-2 w-2 relative\">\n              <span className=\"animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75\"></span>\n              <span className=\"relative inline-flex rounded-full h-2 w-2 bg-emerald-500\"></span>\n            </span>\n            <p className=\"font-mono text-xs uppercase text-emerald-400 tracking-wider\">Active Device: {spotify.deviceName}</p>\n          </div>\n          <h2 className=\"text-3xl font-extrabold tracking-tight font-sans\">Now Playing</h2>\n        </div>\n        <div className=\"bg-slate-900/60 border border-slate-800/80 rounded-2xl px-5 py-2.5 flex items-center gap-3 backdrop-blur-md\">\n          <Volume2 className=\"w-5 h-5 text-slate-400\" />\n          <div className=\"w-24 bg-slate-800 h-1.5 rounded-full overflow-hidden\">\n            <div className=\"bg-emerald-400 h-full rounded-full\" style={{ width: `${spotify.volumePercent}%` }} />\n          </div>\n          <span className=\"text-xs font-mono font-medium text-slate-300\">{spotify.volumePercent}%</span>\n        </div>\n      </div>"
