    replacement_chunks {
      replacement_content: "import React, { useEffect, useState } from \'react\';\nimport { \n  Sparkles, \n  Volume2, \n  ArrowRight,\n  Send\n} from \'lucide-react\';\nimport { RockyData, RockyConversationItem } from \'../types\';\n\nexport default function RockyAssistant() {\n  const [rocky, setRocky] = useState<RockyData | null>(null);\n  const [loading, setLoading] = useState(true);\n  const [userInput, setUserInput] = useState(\'\');\n  const [conversations, setConversations] = useState<RockyConversationItem[]>([]);\n\n  useEffect(() => {\n    async function loadRockyData() {\n      try {\n        const response = await fetch(\'/mock_api/assistant.json\');\n        const data = await response.json();\n        setRocky(data);\n        setConversations(data.conversations);\n        setLoading(false);\n      } catch (err) {\n        console.error(\'Error fetching Rocky assistant info:\', err);\n        setLoading(false);\n      }\n    }\n    loadRockyData();\n  }, []);\n\n  const handleCustomSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!userInput.trim() || !rocky) return;\n\n    // Generate beautifully randomized Eridian acoustic translations\n    const possibleChords = [\n      { chords: \"\342\231\251 \342\231\252 C-Major Triad, F5 harmonic\", trans: \"Pumps are optimal! You look happy and watery today, question? Good!\" },\n      { chords: \"\342\231\253 \342\231\254 B-Flat, D-Minor slide trill\", trans: \"I watch the cameras. No monsters outside! All doors locked. Sol is sleep now.\" },\n      { chords: \"\342\231\252 \342\231\251 E-Flat trills, falling third\", trans: \"Thank you for the update, human friend. Fist bump, select yes!\" },\n      { chords: \"\342\231\251\342\231\255 \342\231\252 G-Minor chord, resonance\", trans: \"Asteria temperature is low, but hot chamber is hot (205\302\260C). We are both safe.\" },\n      { chords: \"\342\231\251 \342\231\252 C5 octave, pure tone resonance\", trans: \"Yes, yes, yes! Solid iron cells are perfect. No air leak found!\" }\n    ];\n    const picked = possibleChords[Math.floor(Math.random() * possibleChords.length)];\n\n    const newItem: RockyConversationItem = {\n      id: `custom-${Date.now()}`,\n      timestamp: new Date().toLocaleTimeString(undefined, { hour: \'2-digit\', minute: \'2-digit\' }),\n      prompt: userInput,\n      chords: picked.chords,\n      translation: picked.trans\n    };\n\n    setConversations((prev) => [newItem, ...prev]);\n    setUserInput(\'\');\n  };\n\n  if (loading || !rocky) {\n    return (\n      <div className=\"flex-1 flex items-center justify-center bg-[#050507] text-slate-400 font-mono\">\n        <div className=\"flex flex-col items-center gap-4\">\n          <div className=\"w-10 h-10 border-4 border-indigo-500/20 border-t-indigo-500 rounded-full animate-spin\" />\n          <p className=\"font-mono text-xs uppercase tracking-wider\">Syncing acoustic transceiver link with Rocky...</p>\n        </div>\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"flex-1 bg-gradient-to-b from-[#0e0f13] via-[#07080a] to-[#040405] p-12 text-white overflow-y-auto custom-scrollbar relative flex flex-col justify-between\">\n      {/* Glow backgrounds */}\n      <div className=\"absolute top-0 right-1/3 w-[800px] h-[400px] bg-indigo-500/5 rounded-full blur-[140px] pointer-events-none\" />\n\n      {/* Header bar */}\n      <div className=\"flex flex-col md:flex-row items-start md:items-end justify-between gap-4 mb-8 pb-6 border-b border-white/5 relative z-10 shrink-0\">\n        <div>\n          <div className=\"flex items-center gap-2 mb-1.5\">\n            <span className=\"w-2.5 h-2.5 rounded-full bg-amber-450 bg-amber-400 animate-pulse\" />\n            <p className=\"text-[10px] font-mono tracking-widest text-amber-400 font-bold uppercase\">Xenon Acoustic Translator</p>\n          </div>\n          <h2 className=\"text-4xl font-extrabold tracking-tight font-display text-white\">\n            Rocky Companion\n          </h2>\n        </div>\n        <div className=\"text-right\">\n          <p className=\"text-xs font-mono text-slate-500 uppercase tracking-widest font-extrabold\">Species: {rocky.species}</p>\n        </div>\n      </div>\n\n      {/* Main Split Body: Left avatar, Right big dialog stream */}\n      <div className=\"grid grid-cols-12 gap-8 items-stretch relative z-10 flex-1 min-h-[450px]\">\n        \n        {/* Left Side: Simplified Rocky Avatar with status badge */}\n        <div className=\"col-span-12 md:col-span-4 flex flex-col justify-center items-center p-8 bg-white/[0.01] border border-white/10 rounded-[2.5rem] backdrop-blur-xl\">\n          <div className=\"w-56 h-56 relative flex items-center justify-center bg-black/40 border border-white/5 rounded-full p-6 mb-6 shadow-inner\">\n            <svg viewBox=\"0 0 100 100\" className=\"w-full h-full text-amber-500 fill-transparent stroke-current stroke-[1.2]\" referrerPolicy=\"no-referrer\">\n              {/* Outer chamber rings */}\n              <circle cx=\"50\" cy=\"50\" r=\"46\" className=\"stroke-slate-800/80 stroke-[0.8]\" strokeDasharray=\"3 3\"/>\n              \n              {/* Pentagonal symmetry body shell representation */}\n              <polygon points=\"50,16 84,41 71,81 29,81 16,41\" className=\"stroke-amber-500/25\" />\n              \n              {/* Five sturdy legs legs */}\n              <path d=\"M 50 16 L 50 4\" className=\"stroke-amber-500 stroke-[1.8] stroke-linecap-round\" strokeLinecap=\"round\" />\n              <path d=\"M 84 41 L 96 35\" className=\"stroke-amber-500 stroke-[1.8] stroke-linecap-round\" strokeLinecap=\"round\" />\n              <path d=\"M 71 81 L 82 93\" className=\"stroke-amber-500 stroke-[1.8] stroke-linecap-round\" strokeLinecap=\"round\" />\n              <path d=\"M 29 81 L 18 93\" className=\"stroke-amber-500 stroke-[1.8] stroke-linecap-round\" strokeLinecap=\"round\" />\n              <path d=\"M 16 41 L 4 35\" className=\"stroke-amber-500 stroke-[1.8] stroke-linecap-round\" strokeLinecap=\"round\" />\n\n              {/* Xenonite carapace core */}\n              <circle cx=\"50\" cy=\"50\" r=\"15\" className=\"stroke-amber-500/80 fill-slate-950/80 stroke-[1.5]\" />\n              <polygon points=\"50,39 59,47 55,57 45,57 41,47\" className=\"stroke-amber-500/40 fill-amber-500/10\" />\n              <circle cx=\"50\" cy=\"50\" r=\"3.5\" className=\"fill-amber-500 stroke-none\" />\n            </svg>\n            \n            <span className=\"absolute bottom-4 right-4 flex h-3 w-3\">\n              <span className=\"animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75\"></span>\n              <span className=\"relative inline-flex rounded-full h-3 w-3 bg-emerald-500\"></span>\n            </span>\n          </div>\n\n          <h3 className=\"text-2xl font-black text-white tracking-tight\">{rocky.name}</h3>\n          <p className=\"text-[10px] font-mono text-amber-500 uppercase tracking-widest font-extrabold mt-1\">Eridian Companion</p>\n          <div className=\"mt-4 px-4 py-1.5 rounded-full bg-white/[0.03] border border-white/5 text-[10px] font-mono text-slate-400\">\n            Mood: <span className=\"text-emerald-400 font-extrabold uppercase\">{rocky.status.mood}</span> \342\200\242 Temp: <span className=\"text-rose-400 font-extrabold\">{rocky.status.bodyTemp}</span>\n          </div>\n        </div>\n\n        {/* Right Side: Big spacious dialog feed */}\n        <div className=\"col-span-12 md:col-span-8 flex flex-col justify-between p-8 bg-white/[0.01] border border-white/10 rounded-[2.5rem] backdrop-blur-xl\">\n          \n          {/* Feed Title */}\n          <div className=\"flex items-center justify-between mb-4 border-b border-white/5 pb-4 shrink-0\">\n            <div className=\"flex items-center gap-2.5\">\n              <Volume2 className=\"w-4 h-4 text-amber-400 animate-pulse\" />\n              <span className=\"text-xs font-mono font-bold text-slate-300 uppercase tracking-wider\">Acoustic Message Logs</span>\n            </div>\n            <span className=\"text-[9px] font-mono text-slate-500 uppercase tracking-wider\">{conversations.length} items decrypted</span>\n          </div>\n\n          {/* Dialog Viewport scroll */}\n          <div className=\"flex-1 overflow-y-auto space-y-6 pr-2 custom-scrollbar max-h-[380px] min-h-[220px]\">\n            {conversations.map((conv) => (\n              <div key={conv.id} className=\"space-y-2 last:mb-0\">\n                {/* Human query */}\n                <div className=\"flex items-baseline gap-2 text-slate-400\">\n                  <span className=\"text-[10px] font-mono font-bold uppercase tracking-wider text-slate-500\">Human:</span>\n                  <p className=\"text-sm font-semibold\">{conv.prompt}</p>\n                  <span className=\"text-[9px] font-mono text-slate-600 ml-auto font-medium\">{conv.timestamp}</span>\n                </div>\n\n                {/* Rocky translation balloon */}\n                <div className=\"p-4 rounded-2xl bg-white/[0.02] border border-white/5 flex gap-3\">\n                  <div className=\"p-1.5 bg-amber-500/10 text-amber-400 rounded-xl shrink-0 h-7 w-7 flex items-center justify-center\">\n                    <Sparkles className=\"w-3.5 h-3.5\" />\n                  </div>\n                  <div>\n                    <div className=\"flex items-baseline gap-2 mb-1\">\n                      <span className=\"text-xs font-mono text-amber-500 font-extrabold\">{rocky.name}</span>\n                      <span className=\"text-[9.5px] font-mono text-slate-500 italic\">({conv.chords})</span>\n                    </div>\n                    <p className=\"text-sm tracking-wide leading-relaxed text-slate-200 font-sans font-medium\">\n                      {conv.translation}\n                    </p>\n                  </div>\n                </div>\n              </div>\n            ))}\n          </div>\n\n          {/* Quick Speak preset tabs */}\n          <div className=\"mt-4 pt-3 border-t border-white/5 shrink-0\">\n            <p className=\"text-[10px] font-mono font-bold uppercase text-slate-500 mb-2\">Suggested updates:</p>\n            <div className=\"flex flex-wrap gap-2\">\n              <button \n                onClick={() => setUserInput(\"Report on the bedroom air vents status.\")}\n                className=\"px-3 py-1.5 rounded-xl bg-white/5 border border-white/5 hover:border-white/15 text-[10px] text-slate-300 font-medium transition-all\"\n              >\n                \"Check air vents\"\n              </button>\n              <button \n                onClick={() => setUserInput(\"Are our backup fuel power cells secure?\")}\n                className=\"px-3 py-1.5 rounded-xl bg-white/5 border border-white/5 hover:border-white/15 text-[10px] text-slate-300 font-medium transition-all\"\n              >\n                \"Check backup fuel cells\"\n              </button>\n              <button \n                onClick={() => setUserInput(\"Let\'s do a central fist bump!\")}\n                className=\"px-3 py-1.5 rounded-xl bg-white/5 border border-white/5 hover:border-white/15 text-[10px] text-slate-300 font-medium transition-all\"\n              >\n                \"Fist bump *clink*\"\n              </button>\n            </div>\n          </div>\n\n          {/* Input text form */}\n          <form onSubmit={handleCustomSubmit} className=\"mt-5 flex gap-3 shrink-0\">\n            <input \n              type=\"text\" \n              value={userInput}\n              onChange={(e) => setUserInput(e.target.value)}\n              placeholder=\"Ask Rocky friend (e.g. Do you have enough fiberglass?)...\"\n              className=\"flex-1 bg-black/40 border border-white/5 rounded-2xl px-5 py-3.5 text-sm font-medium tracking-wide placeholder-slate-700 focus:outline-none focus:border-amber-400 transition-colors\"\n            />\n            <button \n              type=\"submit\"\n              className=\"bg-amber-500 hover:bg-amber-400 text-black px-6 rounded-2xl font-bold flex items-center gap-2 transition-all shadow-xl shadow-amber-500/10 text-sm\"\n            >\n              <Send className=\"w-4 h-4\" />\n              <span>Send</span>\n            </button>\n          </form>\n\n        </div>\n      </div>\n    </div>\n  );\n}"
    }
