    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useEffect, useState } from \'react\';\nimport { \n  Sparkles, \n  Thermometer, \n  Gauge, \n  Heart, \n  HelpCircle, \n  Volume2, \n  CheckSquare, \n  ArrowRight,\n  ShieldAlert,\n  Dna\n} from \'lucide-react\';\nimport { RockyData, RockyConversationItem, VocabularyItem } from \'../types\';\n\nexport default function RockyAssistant() {\n  const [rocky, setRocky] = useState<RockyData | null>(null);\n  const [loading, setLoading] = useState(true);\n  const [userInput, setUserInput] = useState(\'\');\n  const [conversations, setConversations] = useState<RockyConversationItem[]>([]);\n  const [quoteIdx, setQuoteIdx] = useState(0);\n\n  useEffect(() => {\n    async function loadRockyData() {\n      try {\n        const response = await fetch(\'/mock_api/assistant.json\');\n        const data = await response.json();\n        setRocky(data);\n        setConversations(data.conversations);\n        setLoading(false);\n      } catch (err) {\n        console.error(\'Error fetching Rocky assistant info:\', err);\n        setLoading(false);\n      }\n    }\n    loadRockyData();\n  }, []);\n\n  // Cycle quote trills every 12 seconds\n  useEffect(() => {\n    if (!rocky) return;\n    const interval = setInterval(() => {\n      setQuoteIdx((prev) => (prev + 1) % rocky.quotes.length);\n    }, 12000);\n    return () => clearInterval(interval);\n  }, [rocky]);\n\n  // Handle preset assistant triggers or text input\n  const askRockyPreset = (prompt: string, chords: string, translation: string) => {\n    const newItem: RockyConversationItem = {\n      id: `custom-${Date.now()}`,\n      timestamp: new Date().toLocaleTimeString(undefined, { hour: \'2-digit\', minute: \'2-digit\' }),\n      prompt,\n      chords,\n      translation\n    };\n    setConversations((prev) => [newItem, ...prev]);\n  };\n\n  const handleCustomSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!userInput.trim()) return;\n\n    // Generate a beautiful randomized Rocky-themed translation chord sequence\n    const possibleChords = [\n      { chords: \"\342\231\251 \342\231\252 C-Major Triad, F5 harmonic\", trans: \"Pumps are optimal! You look happy and watery today, question? Good!\" },\n      { chords: \"\342\231\253 \342\231\254 B-Flat, D-Minor slide trill\", trans: \"I watch the cameras. No monsters outside! All doors locked. Sol is sleep now.\" },\n      { chords: \"\342\231\252 \342\231\251 E-Flat trills, falling third\", trans: \"Thank you for the update, human friend. Fist bump, select yes!\" },\n      { chords: \"\342\231\251\342\231\255 \342\231\252 G-Minor chord, resonance\", trans: \"Asteria temperature is low, but hot chamber is hot (205\302\260C). We are both safe.\" }\n    ];\n    const picked = possibleChords[Math.floor(Math.random() * possibleChords.length)];\n\n    askRockyPreset(userInput, picked.chords, picked.trans);\n    setUserInput(\'\');\n  };\n\n  if (loading || !rocky) {\n    return (\n      <div className=\"flex-1 flex items-center justify-center bg-slate-950 text-slate-400\">\n        <div className=\"flex flex-col items-center gap-4\">\n          <div className=\"w-10 h-10 border-4 border-amber-400/20 border-t-amber-400 rounded-full animate-spin\" />\n          <p className=\"font-mono text-xs uppercase tracking-wider\">Acquiring acoustic translation link with Rocky...</p>\n        </div>\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"flex-1 bg-slate-950 p-12 text-white overflow-y-auto\">\n      \n      {/* Top Billboard Header */}\n      <div className=\"flex flex-col md:flex-row items-start md:items-end justify-between gap-6 mb-10 pb-8 border-b border-slate-900\">\n        <div>\n          <p className=\"text-amber-400 font-mono text-xs uppercase tracking-widest font-bold\">Xenon Systems Companion</p>\n          <h2 className=\"text-4xl font-extrabold tracking-tight font-sans\">Eridian Advisor: Rocky</h2>\n        </div>\n        <div className=\"text-right\">\n          <p className=\"text-base font-mono text-slate-500 uppercase tracking-widest font-bold\">Project Hail Mary Interface</p>\n        </div>\n      </div>\n\n      <div className=\"grid grid-cols-12 gap-8 items-start\">\n        \n        {/* Left Hand: Custom Rocky Vector Graphic & Status Console (5 Columns) */}\n        <div className=\"col-span-12 lg:col-span-5 flex flex-col gap-8\">\n          \n          {/* Rocky Pentamerous Symmetry Vector Frame */}\n          <section className=\"bg-gradient-to-b from-amber-450/10 to-amber-950/20 bg-slate-900 border border-slate-800 p-8 rounded-[32px] shadow-xl relative overflow-hidden flex flex-col items-center\">\n            {/* Hexagonal decorative grid background representing Rocky\'s shell facets */}\n            <div className=\"absolute inset-0 opacity-[0.02] pointer-events-none bg-[radial-gradient(#fecdd3_1.5px,transparent_1.5px)] [background-size:24px_24px] [mask-image:radial-gradient(ellipse_50%_50%_at_50%_50%,#000_60%,transparent_100%)]\" />\n\n            {/* Stylized Rocky Portrait using full visual SVGs */}\n            <div className=\"w-60 h-60 relative flex items-center justify-center bg-slate-950 border border-slate-800/80 rounded-full p-4 mb-6 shadow-inner\">\n              <svg viewBox=\"0 0 100 100\" className=\"w-full h-full text-amber-400 fill-transparent stroke-current stroke-[1.5]\" referrerPolicy=\"no-referrer\">\n                {/* Outer environment chamber ring */}\n                <circle cx=\"50\" cy=\"50\" r=\"46\" className=\"stroke-slate-800 stroke-[1] stroke-dasharray\" strokeDasharray=\"3 3\"/>\n                <circle cx=\"50\" cy=\"50\" r=\"42\" className=\"stroke-amber-400/20 stroke-[1]\" />\n                \n                {/* Pentagonal facet core framework */}\n                <polygon points=\"50,15 85,40 72,80 28,80 15,40\" className=\"stroke-amber-500/30\" />\n                \n                {/* Five legs arranged in radial pentamerous symmetry (The scary nice stone spider!) */}\n                {/* Leg 1 (Top) */}\n                <path d=\"M 50 15 L 50 5 C 45 1, 40 1, 48 0\" className=\"stroke-amber-400 stroke-[2] stroke-linecap-round\" strokeLinecap=\"round\" />\n                {/* Leg 2 (Right Top) */}\n                <path d=\"M 85 40 L 96 35 C 99 30, 99 25, 96 28\" className=\"stroke-amber-400 stroke-[2] stroke-linecap-round\" strokeLinecap=\"round\" />\n                {/* Leg 3 (Right Bottom) */}\n                <path d=\"M 72 80 L 82 90 C 85 93, 85 97, 80 94\" className=\"stroke-amber-400 stroke-[2] stroke-linecap-round\" strokeLinecap=\"round\" />\n                {/* Leg 4 (Left Bottom) */}\n                <path d=\"M 28 80 L 18 90 C 15 93, 15 97, 20 94\" className=\"stroke-amber-400 stroke-[2] stroke-linecap-round\" strokeLinecap=\"round\" />\n                {/* Leg 5 (Left Top) */}\n                <path d=\"M 15 40 L 4 35 C 1 30, 1 25, 4 28\" className=\"stroke-amber-400 stroke-[2] stroke-linecap-round\" strokeLinecap=\"round\" />\n\n                {/* Central mineral core organism representing xenonite carapace with steel-fiber muscle tissue */}\n                <circle cx=\"50\" cy=\"50\" r=\"16\" className=\"stroke-amber-500/80 fill-slate-900 stroke-[2]\" />\n                <polygon points=\"50,38 60,46 56,58 44,58 40,46\" className=\"stroke-amber-400 fill-amber-400/20\" />\n                <circle cx=\"50\" cy=\"50\" r=\"4\" className=\"fill-amber-400 stroke-none\" />\n              </svg>\n              \n              {/* Hot environment gas indicator */}\n              <span className=\"absolute top-2 right-2 flex h-2.5 w-2.5\">\n                <span className=\"animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75\"></span>\n                <span className=\"relative inline-flex rounded-full h-2.5 w-2.5 bg-red-500\"></span>\n              </span>\n            </div>\n\n            <h3 className=\"text-2xl font-bold tracking-tight text-white\">{rocky.name}</h3>\n            <p className=\"text-slate-400 text-xs font-mono mt-1 uppercase tracking-widest\">{rocky.species} Companion</p>\n            \n            {/* Live rotating quote bubble */}\n            <div className=\"mt-6 bg-slate-950 p-4 rounded-2xl border border-slate-850 w-full min-h-[90px] flex items-center justify-center text-center\">\n              <p className=\"text-xs italic text-amber-300 font-sans tracking-wide leading-relaxed\">\n                {rocky.quotes[quoteIdx]}\n              </p>\n            </div>\n          </section>\n\n          {/* Environmental metrics console panel */}\n          <section className=\"bg-slate-900 border border-slate-800 p-8 rounded-[32px] shadow-xl\">\n            <h4 className=\"text-lg font-bold tracking-tight text-white mb-6 font-sans\">Chamber Climate & Metrics</h4>\n            \n            <div className=\"grid grid-cols-2 gap-4\">\n              <div className=\"bg-slate-950 p-4 rounded-2xl border border-slate-850 flex items-center gap-3\">\n                <Thermometer className=\"w-5 h-5 text-red-400\" />\n                <div>\n                  <p className=\"text-[10px] font-mono text-slate-500 uppercase leading-none\">Chamber Temp</p>\n                  <p className=\"text-lg font-bold font-mono text-white mt-1\">{rocky.status.bodyTemp}</p>\n                </div>\n              </div>\n\n              <div className=\"bg-slate-950 p-4 rounded-2xl border border-slate-850 flex items-center gap-3\">\n                <Gauge className=\"w-5 h-5 text-emerald-400\" />\n                <div>\n                  <p className=\"text-[10px] font-mono text-slate-500 uppercase leading-none\">Pressure</p>\n                  <p className=\"text-lg font-bold font-mono text-white mt-1\">{rocky.status.chamberPressure}</p>\n                </div>\n              </div>\n\n              <div className=\"bg-slate-950 p-4 rounded-2xl border border-slate-850 flex items-center gap-3\">\n                <Dna className=\"w-5 h-5 text-purple-400\" />\n                <div>\n                  <p className=\"text-[10px] font-mono text-slate-500 uppercase leading-none\">Oxygen level</p>\n                  <p className=\"text-lg font-bold font-mono text-white mt-1\">{rocky.status.chamberOxygen}</p>\n                </div>\n              </div>\n\n              <div className=\"bg-slate-950 p-4 rounded-2xl border border-slate-850 flex items-center gap-3\">\n                <Heart className=\"w-5 h-5 text-rose-400\" />\n                <div>\n                  <p className=\"text-[10px] font-mono text-slate-500 uppercase leading-none\">Vitals / Mood</p>\n                  <p className=\"text-sm font-bold text-slate-200 mt-1 truncate\">{rocky.status.mood}</p>\n                </div>\n              </div>\n            </div>\n\n            <div className=\"mt-5 p-4 rounded-xl bg-slate-950 border border-slate-850/60 text-xs\">\n              <p className=\"text-slate-400 leading-relaxed font-sans\">\n                <span className=\"font-bold text-amber-400 block mb-1\">CURRENT ACTIVITY:</span>\n                {rocky.status.activity}\n              </p>\n            </div>\n          </section>\n        </div>\n\n        {/* Right Hand: Vocabulary dictionary and Acoustic Translation Feed (7 Columns) */}\n        <div className=\"col-span-12 lg:col-span-7 flex flex-col gap-8\">\n          \n          {/* Preset Questions / Commands to issue to Rocky (Home Automation Actions) */}\n          <section className=\"bg-slate-900 border border-slate-800 p-8 rounded-[32px] shadow-xl\">\n            <h4 className=\"text-lg font-bold tracking-tight text-white mb-4\">Home Automation Actions (Ask Rocky)</h4>\n            <p className=\"text-xs text-slate-400 mb-6 font-sans leading-relaxed\">\n              Issue requests directly to Rocky&apos;s steel-fiber brain node. Rocky will output acoustic translations to verify action progress.\n            </p>\n\n            <div className=\"grid grid-cols-1 md:grid-cols-2 gap-3.5\">\n              <button \n                onClick={() => askRockyPreset(\n                  \"Seal the central air ventilation channels, Rocky.\", \n                  \"\342\231\253 \342\231\254 F-Sharp, D5 Major slide\", \n                  \"Acoustic seal triggers active! Helium venting valves closed completely. All secure!\"\n                )}\n                className=\"p-4 rounded-2xl bg-slate-950 hover:bg-slate-800 border border-slate-850 hover:border-slate-700 text-left transition-all group\"\n              >\n                <div className=\"flex justify-between items-center text-xs font-mono text-slate-500 font-bold mb-1\">\n                  <span>AIRLOCK TRIGGER</span>\n                  <ArrowRight className=\"w-4 h-4 opacity-0 group-hover:opacity-100 group-hover:text-amber-400 transition-all\" />\n                </div>\n                <p className=\"font-bold text-slate-200 text-sm\">Seal Ventilation Valves</p>\n              </button>\n\n              <button \n                onClick={() => askRockyPreset(\n                  \"Is our master backup power cell online?\", \n                  \"C4 - E4 - G4 - C5 Arpeggio\", \n                  \"Yes! Backup fuel cell hums at ninety-eight percent capacitor! Infinite power, friend!\"\n                )}\n                className=\"p-4 rounded-2xl bg-slate-950 hover:bg-slate-800 border border-slate-850 hover:border-slate-700 text-left transition-all group\"\n              >\n                <div className=\"flex justify-between items-center text-xs font-mono text-slate-500 font-bold mb-1\">\n                  <span>VITALS DIAGNOSTIC</span>\n                  <ArrowRight className=\"w-4 h-4 opacity-0 group-hover:opacity-100 group-hover:text-amber-400 transition-all\" />\n                </div>\n                <p className=\"font-bold text-slate-200 text-sm\">Check Backup Power Status</p>\n              </button>\n\n              <button \n                onClick={() => askRockyPreset(\n                  \"How is the climate regulation running in the bedrooms?\", \n                  \"\342\231\252 E-Flat major chord trills\", \n                  \"Bedrooms are exactly sixty-eight degrees. Leaks are zero. Put paste on any drafts, question? Good!\"\n                )}\n                className=\"p-4 rounded-2xl bg-slate-950 hover:bg-slate-800 border border-slate-850 hover:border-slate-700 text-left transition-all group\"\n              >\n                <div className=\"flex justify-between items-center text-xs font-mono text-slate-500 font-bold mb-1\">\n                  <span>CLIMATE SENSORS</span>\n                  <ArrowRight className=\"w-4 h-4 opacity-0 group-hover:opacity-100 group-hover:text-amber-400 transition-all\" />\n                </div>\n                <p className=\"font-bold text-slate-200 text-sm\">Bedroom Climate Report</p>\n              </button>\n\n              <button \n                onClick={() => askRockyPreset(\n                  \"Rocky, let&apos;s celebrate a successful central server build!\", \n                  \"E\342\231\2554 - B\342\231\2554 - E\342\231\2555 fist bump trill\", \n                  \"Fist bump, nice space monster! *clink* Legs match perfectly!\"\n                )}\n                className=\"p-4 rounded-2xl bg-slate-950 hover:bg-slate-800 border border-slate-850 hover:border-slate-700 text-left transition-all group\"\n              >\n                <div className=\"flex justify-between items-center text-xs font-mono text-amber-400 font-bold mb-1\">\n                  <span>CELEBRATE SUCCESS</span>\n                  <ArrowRight className=\"w-4 h-4 opacity-0 group-hover:opacity-100 group-hover:text-amber-400 transition-all\" />\n                </div>\n                <p className=\"font-bold text-slate-250 text-slate-100 text-sm\">Initiate Fist Bump *clink*</p>\n              </button>\n            </div>\n          </section>\n\n          {/* Acoustic Translation Conversation Stream */}\n          <section className=\"bg-slate-900 border border-slate-800 p-8 rounded-[32px] shadow-xl flex-1 flex flex-col justify-between min-h-[460px]\">\n            <div>\n              <div className=\"flex items-center justify-between mb-6\">\n                <div className=\"flex items-center gap-3\">\n                  <div className=\"p-2 bg-amber-400/10 text-amber-400 rounded-lg\">\n                    <Volume2 className=\"w-5 h-5\" />\n                  </div>\n                  <h4 className=\"text-lg font-bold text-white tracking-tight\">Acoustic Translation Feed</h4>\n                </div>\n                \n                <span className=\"text-[10px] font-mono text-slate-500 uppercase tracking-widest font-extrabold px-2 py-0.5 bg-slate-950 border border-slate-850 rounded\">\n                  {conversations.length} Logs Saved\n                </span>\n              </div>\n\n              {/* Scrollable message stack */}\n              <div className=\"space-y-6 max-h-[360px] overflow-y-auto pr-2 custom-scrollbar\">\n                {conversations.map((conv) => (\n                  <div key={conv.id} className=\"border-b border-slate-800/60 pb-5 last:border-0 last:pb-0\">\n                    {/* Human prompt block */}\n                    <div className=\"flex items-center gap-2 mb-2\">\n                      <span className=\"text-[10px] font-mono font-bold uppercase text-slate-500\">Human:</span>\n                      <span className=\"text-slate-300 text-sm font-semibold\">{conv.prompt}</span>\n                      <span className=\"text-[10px] font-mono text-slate-600 ml-auto font-medium\">{conv.timestamp}</span>\n                    </div>\n\n                    {/* Rocky translation block */}\n                    <div className=\"p-4 rounded-2xl bg-slate-950 border border-slate-850 flex items-start gap-3 mt-1.5\">\n                      <div className=\"p-1.5 bg-amber-400/10 text-amber-400 rounded-lg shrink-0 mt-0.5\">\n                        <Sparkles className=\"w-4 h-4\" />\n                      </div>\n                      <div className=\"flex-1\">\n                        <div className=\"flex items-center gap-2 mb-1\">\n                          <span className=\"text-xs font-mono text-amber-400 font-extrabold\">{rocky.name}:</span>\n                          <span className=\"text-[11px] font-mono text-slate-500 font-medium italic\">{conv.chords}</span>\n                        </div>\n                        <p className=\"text-sm font-sans tracking-wide leading-relaxed text-slate-200 font-medium\">\n                          {conv.translation}\n                        </p>\n                      </div>\n                    </div>\n                  </div>\n                ))}\n              </div>\n            </div>\n\n            {/* Custom translation speech command input box */}\n            <form onSubmit={handleCustomSubmit} className=\"mt-8 pt-6 border-t border-slate-800 flex gap-3\">\n              <input \n                type=\"text\" \n                value={userInput}\n                onChange={(e) => setUserInput(e.target.value)}\n                placeholder=\"Talk with Rocky (e.g. Do you have enough fiberglass?)...\"\n                className=\"flex-1 bg-slate-950 border border-slate-800 rounded-2xl px-5 py-3 text-sm font-medium tracking-wide placeholder-slate-600 focus:outline-none focus:border-amber-400 transition-colors\"\n              />\n              <button \n                type=\"submit\" \n                className=\"bg-amber-400 hover:bg-amber-500 text-slate-950 px-6 rounded-2xl truncate font-bold text-sm tracking-wide transition-all shadow-md shadow-amber-400/10\"\n              >\n                Translate Chord\n              </button>\n            </form>\n          </section>\n\n          {/* Eridian Audio Dictionary Matrix */}\n          <section className=\"bg-slate-900 border border-slate-800 p-8 rounded-[32px] shadow-xl\">\n            <h4 className=\"text-lg font-bold tracking-tight text-white mb-4\">Acoustic Syntax Dictionary</h4>\n            \n            <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n              {rocky.vocabulary.map((v, i) => (\n                <div key={i} className=\"p-4 rounded-2xl bg-slate-950 border border-slate-850 flex justify-between items-center gap-4\">\n                  <div>\n                    <p className=\"text-[10px] font-mono text-slate-500 uppercase leading-none font-bold\">{v.concept}</p>\n                    <p className=\"text-sm font-bold text-amber-400 mt-1.5\">{v.english}</p>\n                  </div>\n                  <div className=\"text-right shrink-0\">\n                    <span className=\"text-[10px] font-mono font-medium text-slate-550 block text-slate-400\">{v.soundNotes}</span>\n                  </div>\n                </div>\n              ))}\n            </div>\n          </section>\n        </div>\n      </div>\n    </div>\n  );\n}\n"
    }
