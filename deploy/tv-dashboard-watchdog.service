[Unit]
Description=TV Dashboard Watchdog - Ensure services are running
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/bin/bash -c 'systemctl is-active tv-dashboard-api || systemctl restart tv-dashboard-api; systemctl is-active nginx || systemctl restart nginx'
RemainAfterExit=no

[Install]
WantedBy=multi-user.target